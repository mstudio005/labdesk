// LabDesk look: warm paper background, hairline borders, black active states, one accent colour per area.
export global Theme {
    out property <color> bg: #f3f1ec;
    out property <color> paper: #faf9f6;
    out property <color> ink: #14130f;
    out property <color> muted: #77736a;
    out property <color> line: #d8d4ca;
    out property <color> hover: #ebe8e0;
    out property <color> blue: #2f5bd6;
    out property <color> green: #1f7a4a;
    out property <color> amber: #b5791a;
    out property <color> red: #b3261e;
    out property <color> pink: #d62f86;
    out property <string> mono: "Consolas";
    out property <string> sans: "Segoe UI";
    // motion
    out property <duration> quick: 130ms;
    out property <duration> page: 280ms;
}
