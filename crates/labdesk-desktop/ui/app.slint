    // email settings (Admin)
    in-out property <int> em-on: 0; in-out property <int> em-provider: 0; in-out property <string> em-host; in-out property <string> em-port; in-out property <string> em-user; in-out property <string> em-pass; in-out property <string> em-name; in-out property <string> err-em; in property <bool> em-busy: false;
    callback em-save(); callback em-test();
    callback sign-in(); callback create-first-admin(); callback sign-out();
    callback te-query-changed(); callback te-new(); callback te-open(int); callback te-save();
    callback te-back(); callback te-reset(); callback te-preview(); callback te-copy-changed(); callback te-copy-pick(int); callback te-open-text(int);
    callback ci-save(); callback ci-cancel();
    callback fp-pick(int); callback fp-new(); callback fp-submit(); callback row-delete(int); callback row-move(int, int); callback row-select(int, bool); callback rows-delete-selected();
    callback ar-open(bool); callback ar-add(); callback ar-remove(int); callback ar-edit(int, int, string); callback ar-done(); callback ar-cancel();
    callback pick-design(int);
    callback prepare-choices(int);
    callback forgot-open(); callback forgot-back(); callback recover(); callback find-username(); in property <string> f-found; callback new-recovery-code(); callback rc-save-copy(); callback rc-done();
    callback ue-remove(); callback confirm-yes-clicked(); callback confirm-no-clicked();
    callback ue-new(); callback ue-open(int); callback ue-save(); callback change-my-password();
    callback choose-letterhead(); callback remove-letterhead(); callback choose-signature(); callback remove-signature();
    callback save-settings(); callback print-test-page();
    callback import-tests(); callback load-samples(); callback backup-now();
    callback dismiss-toast();
