import { ScrollView, TextEdit } from "std-widgets.slint";
import { Theme } from "theme.slint";
import { Padlock, Micro, PageIn, Btn, Chip, Field, Seg, StatusChip, FlagChip, StatCard, Toast, Tick, Cross, Pick, Check } from "widgets.slint";

export struct OrderRow { id: int, code: string, name: string, age-gender: string, tests: string, status: string, total: string, due: string, when: string }
// kind: 0 = result entry row, 1 = section title, 2 = test header
export struct ParamRow { order-test-id: int, param-id: string, name: string, unit: string, range: string, value: string, flag: string, kind: int, formula: bool, locked: bool, status: string, choice: bool }
export struct TestAdminRow { id: int, code: string, name: string, dept: string, price: string, off: bool }
// one editable result line of a test (src = position in the saved test, -1 for a new line)
// typ: 0 number, 1 text, 2 choice list, 3 other (heading, age/gender ranges); fixed = the type cannot be changed
export struct FRow { name: string, field: string, unit: string, range: string, formula: bool, selected: bool, active: bool, title: bool, hidden: bool }
export struct ARow { gender: string, from: string, to: string, unit: string, low: string, high: string, clow: string, chigh: string, text: string }
export struct UserRow { id: int, name: string, username: string, role: string, active: bool }
export struct HelpRow { title: string, body: string }
export struct DeletedRow { id: int, name: string, code: string, note: string, total: string }
export struct PatRow { id: int, name: string, code: string, meta: string, visits: string, last: string }
export struct SumRow { kind: int, name: string, value: string, range: string, flag: string }
export struct TrPoint { x: float, y: float, label: string, bad: bool }
export struct SmRow { kind: int, a: string, b: string }
export struct AnKpi { label: string, value: string, change: string, tone: int }
export struct AnBar { label: string, a: float, b: float }
export struct AnRow { label: string, value: string, frac: float }
export struct PayRow { when: string, how: string, bill: string, amount: string }
export struct MachRow { id: int, name: string, sample: string, time: string, status: string, abn: string }
export struct MachItemRow { name: string, value: string, unit: string, range: string, flag: string }
export struct HistRow { name: string, path: string, lines: [float], labels: [string], fill: color }
export struct CandRow { order-test-id: int, title: string, sub: string, hint: string }
export struct CountRow { name: string, times: string, last: string }
// kind: 0 = a visit, 1 = a test done at that visit.  tone: 0 plain, 1 green, 2 amber, 3 red
export struct TreeRow { kind: int, order-id: int, title: string, sub: string, right: string, status: string, tone: int }
export struct TestRow { id: int, code: string, name: string, dept: string, price: string, selected: bool }

// A small drawing of one patient-box design, so the lab can pick by sight.
component HeaderThumb inherits Rectangle {
    in property <int> design; in property <bool> active; in property <string> name;
    callback clicked();
    width: 205px; height: 128px;
    background: root.active ? #e7eefc : (ta.has-hover ? #f7f5f0 : transparent);
    border-width: root.active ? 2px : 1px; border-color: root.active ? Theme.blue : Theme.line;
    animate background { duration: Theme.quick; }
    Rectangle {
        x: 10px; y: 8px; width: parent.width - 20px; height: 82px;
        background: (root.design == 4 || root.design == 5) ? #eeede9 : white;
        border-width: (root.design == 0 || root.design == 1) ? 1px : (root.design == 3 ? 2.5px : 0px); border-color: Theme.ink;
        if root.design == 2: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.ink; }
        if root.design == 4: Rectangle { y: 0px; height: 1px; background: #8d897f; }
        if root.design == 4: Rectangle { y: parent.height - 1px; height: 1px; background: #8d897f; }
        if root.design == 1: Rectangle { x: 112px; y: 8px; width: 1px; height: parent.height - 16px; background: #8d897f; }
        if root.design == 7: Rectangle { x: 70px; y: 8px; width: 1.5px; height: parent.height - 16px; background: Theme.ink; }
        if root.design == 7: Rectangle { x: parent.width - 52px; y: 8px; width: 1.5px; height: parent.height - 16px; background: Theme.ink; }
        for r in 4: Rectangle { x: 10px; y: 12px + r * 16px; width: 50px; height: 4px; background: #77736a; }
        for r in 4: Rectangle { x: root.design == 1 ? 122px : 78px; y: 12px + r * 16px; width: 48px; height: 4px; background: #77736a; }
        Rectangle { x: root.design == 1 ? 68px : parent.width - 44px; y: 12px; width: 36px; height: 36px; background: Theme.ink;
            Rectangle { x: 4px; y: 4px; width: 10px; height: 10px; background: white; }
            Rectangle { x: parent.width - 14px; y: 4px; width: 10px; height: 10px; background: white; }
            Rectangle { x: 4px; y: parent.height - 14px; width: 10px; height: 10px; background: white; }
        }
    }
    Text { x: 10px; y: 98px; width: parent.width - 20px; text: root.name; font-size: 12px; font-weight: root.active ? 700 : 500; color: root.active ? Theme.blue : Theme.ink; overflow: elide; }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component Panel inherits Rectangle {
    background: Theme.paper; border-width: 1px; border-color: Theme.line;
}

// A panel that is exactly as tall as what is inside it.
component AutoPanel inherits Rectangle {
    background: Theme.paper; border-width: 1px; border-color: Theme.line;
    height: lay.preferred-height;
    lay := VerticalLayout { padding: 22px; spacing: 12px; alignment: start; @children }
}

// A small figure with a caption, for the patient summary.
component Mini inherits Rectangle {
    in property <string> label; in property <string> value; in property <string> hint; in property <color> tone: Theme.ink;
    horizontal-stretch: 1; height: 78px; background: Theme.paper; border-width: 1px; border-color: Theme.line;
    VerticalLayout { padding: 12px; spacing: 3px; alignment: center;
        Micro { text: root.label; }
        Text { text: root.value; font-size: 20px; font-weight: 700; color: root.tone; overflow: elide; }
        Text { text: root.hint; font-size: 11px; color: Theme.muted; overflow: elide; }
    }
}

// Shown after a report's QR code was scanned: does the paper match what the lab approved?
component VerdictBar inherits Rectangle {
    in property <int> kind; in property <string> text; in property <bool> can-open;
    callback open(); callback dismiss();
    height: 56px;
    background: root.kind == 1 ? #1f7a4a14 : #b3261e14;
    border-width: 1px; border-color: root.kind == 1 ? Theme.green : Theme.red;
    HorizontalLayout { padding: 14px; padding-top: 8px; padding-bottom: 8px; spacing: 12px;
        Text { text: root.text; horizontal-stretch: 1; font-size: 13px; font-weight: 700; color: root.kind == 1 ? Theme.green : Theme.red; vertical-alignment: center; wrap: word-wrap; }
        if root.can-open: VerticalLayout { alignment: center; Btn { text: "OPEN THIS REPORT"; height: 30px; clicked => { root.open(); } } }
        VerticalLayout { alignment: center; Btn { text: "OK"; height: 30px; clicked => { root.dismiss(); } } }
    }
}

// The patient's details. Used when registering and when correcting a patient later.
component PatientForm inherits VerticalLayout {
    in-out property <string> first; in-out property <string> last; in-out property <string> age;
    in-out property <int> age-type: 0; in-out property <int> gender: 0;
    in-out property <string> phone; in-out property <string> email; in-out property <string> address;
    in-out property <int> ref-mode: 0; in-out property <string> doctor;
    in-out property <string> err-first; in-out property <string> err-age; in-out property <string> err-address; in-out property <string> err-email; in-out property <string> err-doctor;
    in property <bool> lock-name: false; in property <bool> lock-gender: false; in property <bool> lock-body: false; in property <bool> lock-ref: false;
    in property <[string]> suggestions;
    callback doctor-edited(string);
    spacing: 12px; alignment: start;
    HorizontalLayout { spacing: 10px;
        Field { horizontal-stretch: 1; preferred-width: 0px; label: "First name"; text <=> root.first; read-only: root.lock-name; error: root.err-first; edited(_) => { root.err-first = ""; } }
        Field { horizontal-stretch: 1; preferred-width: 0px; label: "Last name"; text <=> root.last; read-only: root.lock-name; }
    }
    HorizontalLayout { spacing: 10px;
        Field { label: "Age"; text <=> root.age; width: 96px; mono: true; numeric: true; read-only: root.lock-body; error: root.err-age != "" ? " " : ""; edited(_) => { root.err-age = ""; } }
        Seg { label: "Age in"; options: ["Years", "Months", "Days"]; locked: [root.lock-body, root.lock-body, root.lock-body]; index <=> root.age-type; }
    }
    if root.err-age != "": Text { text: root.err-age; color: Theme.red; font-size: 12px; font-weight: 600; wrap: word-wrap; }
    Seg { label: "Gender"; options: ["Male", "Female", "Other"]; locked: [root.lock-body || root.lock-gender, root.lock-body || root.lock-gender, root.lock-body || root.lock-gender]; index <=> root.gender; }
    HorizontalLayout { spacing: 10px;
        Field { horizontal-stretch: 1; preferred-width: 0px; label: "Phone"; text <=> root.phone; mono: true; }
        Field { horizontal-stretch: 1; preferred-width: 0px; label: "Email (optional)"; placeholder: "name@example.com"; text <=> root.email; error: root.err-email; edited(_) => { root.err-email = ""; } }
    }
    Field { label: "Address"; placeholder: "Required"; text <=> root.address; error: root.err-address; edited(_) => { root.err-address = ""; } }
    Seg { label: "Who sent the patient?"; options: ["Self (walk-in)", "A doctor"]; locked: [root.lock-ref, root.lock-ref]; index <=> root.ref-mode; }
    if root.ref-mode == 1: VerticalLayout { spacing: 6px;
        Field { label: "Doctor's name"; placeholder: "e.g. Dr. Rashid Khan"; text <=> root.doctor; read-only: root.lock-ref; error: root.err-doctor; edited(t) => { root.err-doctor = ""; root.doctor-edited(t); } }
        if root.suggestions.length > 0 && !root.lock-ref: HorizontalLayout { spacing: 6px; alignment: start; height: 28px;
            for sug in root.suggestions: Rectangle {
                width: min(sl.preferred-width + 20px, 190px);
                border-width: 1px; border-color: Theme.line; background: sa.has-hover ? Theme.hover : Theme.paper;
                sl := Text { x: 10px; width: parent.width - 20px; text: sug; font-size: 12px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                sa := TouchArea { clicked => { root.doctor = sug; root.doctor-edited(sug); } mouse-cursor: pointer; }
            }
        }
    }
}

component CheckRow inherits Rectangle {
    in property <string> text;
    in property <string> hint;
    in property <bool> done;
    callback clicked();
    height: 54px;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 14px;
        Rectangle {
            width: 24px; height: 24px; y: (parent.height - self.height) / 2; border-radius: 12px;
            background: root.done ? Theme.green : transparent; border-width: 2px; border-color: root.done ? Theme.green : Theme.line;
            animate background { duration: 300ms; }
            if root.done: Tick { x: 5px; y: 5px; width: 14px; height: 14px; }
        }
        VerticalLayout {
            alignment: center;
            Text { text: root.text; font-size: 14px; font-weight: 600; color: root.done ? Theme.muted : Theme.ink; }
            Text { text: root.hint; font-size: 12px; color: Theme.muted; }
        }
        Text { text: root.done ? "" : "→"; color: Theme.muted; font-size: 16px; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component AttnRow inherits Rectangle {
    in property <OrderRow> o;
    in property <int> index;
    callback clicked();
    in-out property <float> t: 0;
    opacity: root.t;
    animate t { delay: 250ms + root.index * 60ms; duration: 320ms; easing: ease-out; }
    init => { self.t = 1; }
    height: 56px;
    background: ta.has-hover ? Theme.hover : transparent;
    animate background { duration: Theme.quick; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    HorizontalLayout {
        padding-left: 18px; padding-right: 18px; spacing: 12px;
        VerticalLayout {
            width: 220px; alignment: center;
            Text { text: root.o.name; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
            Text { text: root.o.age-gender + "  ·  " + root.o.when; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        Text { text: root.o.tests; horizontal-stretch: 1; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
        Rectangle { width: 86px; StatusChip { status: root.o.status; } }
        Text { text: root.o.due; width: 80px; horizontal-alignment: right; font-family: Theme.mono; font-size: 12px; color: root.o.due == "—" ? Theme.muted : Theme.red; vertical-alignment: center; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

component SideItem inherits Rectangle {
    in property <string> text;
    in property <bool> active;
    callback clicked();
    height: 42px;
    background: root.active ? Theme.ink : (ta.has-hover ? Theme.hover : transparent);
    animate background { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: 16px; padding-right: 10px;
        Text { text: root.text; color: root.active ? white : Theme.ink; font-size: 14px; font-weight: root.active ? 700 : 500; vertical-alignment: center; animate color { duration: Theme.quick; } }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

// A small bordered box for numbers and short text inside a table row.
component Cell inherits Rectangle {
    in property <string> text;
    in property <bool> mono: true;
    in property <string> placeholder;
    callback edited(string);
    height: 32px;
    background: white;
    border-width: input.has-focus ? 2px : 1px;
    border-color: input.has-focus ? Theme.ink : Theme.line;
    animate border-color { duration: Theme.quick; }
    HorizontalLayout {
        padding-left: 7px; padding-right: 7px;
        input := TextInput { text: root.text; font-size: 13px; font-family: root.mono ? Theme.mono : Theme.sans; color: Theme.ink; vertical-alignment: center; edited => { root.edited(self.text); } }
    }
    if input.text == "" && root.placeholder != "": Text { x: 7px; text: root.placeholder; color: #b3afa5; font-size: 12px; vertical-alignment: center; }
}

component ListItem inherits Rectangle {
    in property <string> title;
    in property <string> sub;
    in property <string> side;
    in property <bool> dim: false;
    in property <bool> active: false;
    callback clicked();
    height: 54px;
    background: root.active ? Theme.hover : (ta.has-hover ? #f7f5f0 : transparent);
    animate background { duration: Theme.quick; }
    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
    Rectangle { x: 0; width: 4px; background: Theme.ink; opacity: root.active ? 1 : 0; animate opacity { duration: Theme.quick; } }
    HorizontalLayout {
        padding-left: 16px; padding-right: 14px; spacing: 10px;
        VerticalLayout {
            alignment: center; horizontal-stretch: 1;
            Text { text: root.title; font-size: 14px; font-weight: 600; color: root.dim ? Theme.muted : Theme.ink; overflow: elide; }
            Text { text: root.sub; font-size: 11px; color: Theme.muted; overflow: elide; }
        }
        Text { text: root.side; font-family: Theme.mono; font-size: 12px; color: Theme.muted; vertical-alignment: center; horizontal-alignment: right; }
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

/// One number on the Analytics page, with how it changed compared with the period before (green good, red bad).
component AnCard inherits Rectangle {
    in property <string> label; in property <string> value; in property <string> change; in property <int> tone: 0;
    horizontal-stretch: 1; min-width: 120px; height: 104px;
    background: Theme.paper; border-width: 1px; border-color: Theme.line;
    VerticalLayout {
        padding: 14px; spacing: 4px; alignment: center;
        Micro { text: root.label; font-size: 10px; }
        Text { text: root.value; font-size: 24px; font-weight: 700; color: Theme.ink; overflow: elide; }
        Text { text: root.change; font-size: 11px; overflow: elide; color: root.tone == 1 ? Theme.green : root.tone == 2 ? Theme.red : Theme.muted; }
    }
}

/// Upright bars, one per day (or month): the light bar is the larger figure, the dark bar the smaller one drawn in front.
component AnChart inherits Rectangle {
    in property <[AnBar]> bars; in property <color> tone: Theme.blue; in property <string> top-note; in property <string> note;
    height: 230px;
    VerticalLayout {
        spacing: 6px;
        Text { text: root.top-note; font-size: 11px; color: Theme.muted; }
        Rectangle {
            vertical-stretch: 1;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            HorizontalLayout {
                spacing: root.bars.length > 45 ? 1px : 3px;
                for b in root.bars: Rectangle {
                    Rectangle { x: 0px; y: parent.height - self.height - 1px; width: parent.width; height: max(b.a > 0 ? 2px : 0px, (parent.height - 2px) * b.a); background: root.tone.with-alpha(0.25); }
                    Rectangle { x: 0px; y: parent.height - self.height - 1px; width: parent.width; height: max(b.b > 0 ? 2px : 0px, (parent.height - 2px) * b.b); background: root.tone; }
                }
            }
        }
        HorizontalLayout {
            Text { text: root.bars.length > 0 ? root.bars[0].label : ""; font-size: 10px; font-family: Theme.mono; color: Theme.muted; }
            Rectangle { horizontal-stretch: 1; }
            Text { text: root.bars.length > 1 ? root.bars[root.bars.length - 1].label : ""; font-size: 10px; font-family: Theme.mono; color: Theme.muted; }
        }
        Text { text: root.note; font-size: 11px; color: Theme.ink; wrap: word-wrap; }
    }
}

/// A short list with a bar behind each line: payment methods, departments, tests, doctors.
component AnBars inherits VerticalLayout {
    in property <[AnRow]> rows; in property <color> tone: Theme.blue; in property <string> empty: "Nothing in these days";
    spacing: 7px;
    for r in root.rows: Rectangle {
        height: 30px;
        Rectangle { x: 0px; width: parent.width * r.frac; background: root.tone.with-alpha(0.16); }
        Rectangle { x: 0px; width: 3px; background: root.tone; }
        HorizontalLayout { padding-left: 10px; padding-right: 8px; spacing: 8px;
            Text { text: r.label; font-size: 12px; color: Theme.ink; vertical-alignment: center; overflow: elide; horizontal-stretch: 1; }
            Text { text: r.value; font-size: 12px; font-weight: 700; font-family: Theme.mono; color: Theme.ink; vertical-alignment: center; horizontal-alignment: right; }
        }
    }
    if root.rows.length == 0: Text { text: root.empty; font-size: 12px; color: Theme.muted; }
}

/// A titled box for the Analytics page.
component AnBox inherits Rectangle {
    in property <string> title; in property <color> tone: Theme.blue;
    horizontal-stretch: 1;
    background: Theme.paper; border-width: 1px; border-color: Theme.line;
    VerticalLayout {
        padding: 18px; spacing: 12px; alignment: start;
        Micro { text: root.title; color: root.tone; }
        @children
    }
}

/// The empty part of the title bar: drag it to move the window, double-click it to maximize or restore.
/// Positions are measured inside the window.
component DragBar inherits TouchArea {
    callback down(length, length);
    callback drag(length, length);
    callback toggle();
    pointer-event(e) => {
        if e.kind == PointerEventKind.down && e.button == PointerEventButton.left {
            root.down(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y);
        }
    }
    moved => { if self.pressed { root.drag(self.absolute-position.x + self.mouse-x, self.absolute-position.y + self.mouse-y); } }
    double-clicked => { root.toggle(); }
}

/// One button of the window's own title bar: minimize, maximize, restore or close.
component WinBtn inherits Rectangle {
    in property <int> kind; // 0 minimize, 1 maximize, 2 restore, 3 close
    callback clicked();
    width: 52px;
    property <color> ink: root.kind == 3 && ta.has-hover ? white : Theme.ink;
    background: ta.has-hover ? (root.kind == 3 ? #d0342c : Theme.hover) : transparent;
    animate background { duration: Theme.quick; }
    Rectangle { x: 0px; width: 1px; background: Theme.line; }
    if root.kind == 0: Rectangle { width: 12px; height: 1.5px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; background: root.ink; }
    if root.kind == 1: Rectangle { width: 11px; height: 11px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2; border-width: 1.5px; border-color: root.ink; }
    if root.kind == 2: Rectangle {
        width: 12px; height: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        Rectangle { x: 3px; y: 0px; width: 9px; height: 9px; border-width: 1.5px; border-color: root.ink; }
        Rectangle { x: 0px; y: 3px; width: 9px; height: 9px; border-width: 1.5px; border-color: root.ink; background: ta.has-hover ? Theme.hover : Theme.paper; }
    }
    if root.kind == 3: Path {
        width: 12px; height: 12px; x: (parent.width - self.width) / 2; y: (parent.height - self.height) / 2;
        viewbox-x: 0; viewbox-y: 0; viewbox-width: 12; viewbox-height: 12;
        commands: "M 0 0 L 12 12 M 12 0 L 0 12"; stroke: root.ink; stroke-width: 1.5px;
    }
    ta := TouchArea { clicked => { root.clicked(); } mouse-cursor: pointer; }
}

export component AppWindow inherits Window {
    title: "LabDesk";
    // The window draws its own title bar (see the top bar below); Windows adds no frame of its own.
    no-frame: true;
    resize-border-width: 6px;
    icon: @image-url("../assets/logo.png");
    min-width: 1290px; min-height: 680px;
    preferred-width: 1360px; preferred-height: 820px;
    background: Theme.bg;
    default-font-family: Theme.sans;

    // ---- state shared with Rust ----
    // pages: 0 home, 1 new patient, 2 reports, 3 settings, 4 result sheet
    in-out property <int> page: 0;
    // who is signed in
    in-out property <bool> signed-in: false;
    in property <bool> auth-first-run: false;
    in property <string> user-name; in property <string> user-role; in property <bool> is-admin: false; in property <bool> can-money: false;
    in-out property <string> l-user; in-out property <string> l-pass; in-out property <string> err-login;
    in-out property <string> a-name; in-out property <string> a-user; in-out property <string> a-pass; in-out property <string> a-pass2;
    in-out property <string> err-a-name; in-out property <string> err-a-user; in-out property <string> err-a-pass; in-out property <string> err-a-pass2;
    in-out property <bool> auth-forgot: false;
    in-out property <string> f-user; in-out property <string> f-code; in-out property <string> f-pass; in-out property <string> f-pass2;
    in-out property <string> err-f-user; in-out property <string> err-f-code; in-out property <string> err-f-pass; in-out property <string> err-f-pass2;
    in property <bool> rc-shown: false; in property <string> rc-code; in property <bool> has-recovery: false;
    property <float> rveil: root.rc-shown ? 1 : 0;
    animate rveil { duration: 260ms; easing: ease-out; }
    property <float> veil: root.signed-in ? 0 : 1;
    animate veil { duration: 420ms; easing: ease-in-out; }
    property <[string]> nav-names: root.can-money ? ["HOME", "NEW PATIENT", "PATIENTS", "REPORTS", "SCAN", "ANALYZER", "ANALYTICS", "SETTINGS"] : ["HOME", "NEW PATIENT", "PATIENTS", "REPORTS", "SCAN", "ANALYZER", "SETTINGS"];
    property <[int]> nav-pages: root.can-money ? [0, 1, 6, 2, 7, 8, 9, 3] : [0, 1, 6, 2, 7, 8, 3];
    property <int> nav-index: root.page == 6 ? 2 : (root.page == 2 || root.page == 4) ? 3 : root.page == 7 ? 4 : root.page == 8 ? 5 : root.page == 9 ? 6 : root.page == 3 ? (root.can-money ? 7 : 6) : root.page;

    in property <string> toast-text;
    in property <bool> toast-bad: false;
    in-out property <bool> toast-shown: false;

