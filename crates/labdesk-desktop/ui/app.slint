    callback doctor-edited(string); callback e-doctor-edited(string);
    callback choose-backup-folder(); callback choose-cloud-folder(); callback clear-cloud-folder(); callback save-backup-settings();
    callback restore-backup(); callback restore-first-run(); callback restore-deleted(int);
    // analytics (Admin and Reception)
    in property <[AnKpi]> an-today; in property <[AnKpi]> an-kpis;
    in property <[AnBar]> an-money; in property <[AnBar]> an-visits; in property <[AnBar]> an-hours;
    in property <[AnRow]> an-methods; in property <[AnRow]> an-depts; in property <[AnRow]> an-tests; in property <[AnRow]> an-docs;
    in property <string> an-title; in property <string> an-money-top; in property <string> an-money-note; in property <string> an-visits-top; in property <string> an-visits-note;
    in property <string> an-people; in property <string> an-hours-note;
    in-out property <string> an-from; in-out property <string> an-to; in-out property <string> err-an;
    in-out property <int> an-sel: 1;
    callback an-range(int); callback an-run();
    in property <bool> win-maxed: false;
    callback win-minimize(); callback win-maximize(); callback win-close(); callback win-drag-down(length, length); callback win-drag-to(length, length);
    callback help-edited(string); callback make-problem-report(); callback open-github(); callback open-data-folder();

    VerticalLayout {
        // ---------- top bar ----------
        Rectangle {
            height: 56px; background: Theme.paper;
            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: 18px; padding-right: 0px; spacing: 0px;
                Rectangle {
                    width: 180px;
                    DragBar { down(x, y) => { root.win-drag-down(x, y); } drag(x, y) => { root.win-drag-to(x, y); } toggle => { root.win-maximize(); } }
                    HorizontalLayout {
                        spacing: 11px;
                        Image { source: @image-url("../assets/logo-64.png"); width: 32px; height: 32px; y: (parent.height - self.height) / 2; }
                        Text { text: "LABDESK"; font-family: Theme.mono; font-size: 17px; font-weight: 800; letter-spacing: 3px; color: Theme.ink; vertical-alignment: center; }
                    }
                }
                Rectangle { width: 1px; background: Theme.line; }
                Rectangle { width: 14px; }
                nav := Rectangle {
                    // the tabs share the room that is left (between 84 and 104 px each), so the window buttons always fit
                    horizontal-stretch: 1; min-width: root.nav-names.length * 84px; max-width: root.nav-names.length * 104px;
                    property <length> tw: self.width / root.nav-names.length;
                    // the black marker slides to the tab you pick
                    Rectangle { x: root.nav-index * nav.tw; width: nav.tw; background: Theme.ink; animate x { duration: 320ms; easing: cubic-bezier(0.3, 0.85, 0.3, 1); } }
                    for name[i] in root.nav-names: Rectangle {
                        x: i * nav.tw; width: nav.tw;
                        background: ta.has-hover && root.nav-index != i ? Theme.hover : transparent;
                        animate background { duration: Theme.quick; }
                        Text { text: name; color: root.nav-index == i ? white : Theme.ink; font-family: Theme.mono; font-size: 11px; font-weight: 700; letter-spacing: 1.6px; horizontal-alignment: center; vertical-alignment: center; animate color { duration: 200ms; } }
                        if root.nav-pages[i] == 8 && root.mach-new > 0: Rectangle { x: parent.width - 30px; y: 10px; width: 20px; height: 18px; background: Theme.pink; border-radius: 9px;
                            Text { text: root.mach-new; color: white; font-size: 10px; font-weight: 800; horizontal-alignment: center; vertical-alignment: center; } }
                        ta := TouchArea { clicked => { root.navigate(root.nav-pages[i]); } mouse-cursor: pointer; }
                    }
                }
                Rectangle { horizontal-stretch: 1; DragBar { down(x, y) => { root.win-drag-down(x, y); } drag(x, y) => { root.win-drag-to(x, y); } toggle => { root.win-maximize(); } } }
                VerticalLayout {
                    alignment: center; spacing: 1px;
                    Text { text: root.user-name; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: right; }
                    Micro { text: root.user-role.to-uppercase(); horizontal-alignment: right; font-size: 10px; }
                }
                Rectangle { width: 14px; }
                VerticalLayout { alignment: center; Btn { text: "SIGN OUT"; height: 30px; clicked => { root.sign-out(); } } }
                Rectangle { width: 14px; }
                WinBtn { kind: 0; clicked => { root.win-minimize(); } }
                WinBtn { kind: root.win-maxed ? 2 : 1; clicked => { root.win-maximize(); } }
                WinBtn { kind: 3; clicked => { root.win-close(); } }
            }
        }

        // ---------- pages ----------
        Rectangle {
            vertical-stretch: 1;

            // ===== HOME =====
            if root.page == 0: PageIn {
                VerticalLayout {
                    padding: 28px; padding-top: 24px; spacing: 20px;
                    HorizontalLayout {
                        VerticalLayout {
                            spacing: 2px; alignment: center;
                            Text { text: root.greeting; font-size: 30px; font-weight: 700; color: Theme.ink; }
                            Text { text: (root.lab-name != "" ? root.lab-name + "  ·  " : "") + root.today-text; font-size: 13px; color: Theme.muted; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { text: "+  NEW PATIENT"; primary: true; y: (parent.height - self.height) / 2; clicked => { root.navigate(1); } }
                    }
                    HorizontalLayout {
                        spacing: 16px; height: 128px;
                        StatCard { index: 0; label: "TODAY'S PATIENTS"; value: root.stat-patients; hint: "registered today"; tone: Theme.blue; clicked => { root.navigate(2); } }
                        StatCard { index: 1; label: "WAITING FOR RESULTS"; value: root.stat-pending; hint: "reports to complete"; tone: Theme.amber; clicked => { root.navigate(2); } }
                        StatCard { index: 2; label: "READY TO HAND OVER"; value: root.stat-ready; hint: "approved, not yet delivered"; tone: Theme.green; clicked => { root.navigate(2); } }
                        StatCard { index: 3; label: "MONEY DUE"; value: root.stat-due; hint: root.stat-collected; tone: Theme.pink; clicked => { root.navigate(2); } }
                    }
                    HorizontalLayout {
                        spacing: 20px; vertical-stretch: 1;
                        Panel {
                            horizontal-stretch: 1;
                            VerticalLayout {
                                Rectangle {
                                    height: 46px;
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                    HorizontalLayout {
                                        padding-left: 18px; padding-right: 18px;
                                        Micro { text: "NEEDS ATTENTION"; color: Theme.ink; vertical-alignment: center; }
                                        Rectangle { horizontal-stretch: 1; }
                                        Text { text: "View all reports →"; font-size: 12px; color: Theme.blue; vertical-alignment: center; TouchArea { clicked => { root.navigate(2); } mouse-cursor: pointer; } }
                                    }
                                }
                                ScrollView {
                                    vertical-stretch: 1;
                                    VerticalLayout {
                                        for o[i] in root.attention: AttnRow { o: o; index: i; clicked => { root.open-order(o.id); } }
                                        if root.attention.length == 0: Rectangle {
                                            height: 170px;
                                            VerticalLayout {
                                                alignment: center; spacing: 6px;
                                                Text { text: "You're all caught up"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                                Text { text: "Reports that are waiting for results or for hand-over will appear here."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                        if !root.setup-all: Panel {
                            width: 360px;
                            VerticalLayout {
                                alignment: start;
                                Rectangle {
                                    height: 46px;
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                    HorizontalLayout { padding-left: 18px; Micro { text: "GET YOUR LAB READY"; color: Theme.ink; vertical-alignment: center; } }
                                }
                                CheckRow { text: "Lab name and address"; hint: "Printed at the top of every report"; done: root.setup-name; clicked => { root.s-tab = root.is-admin ? 0 : 5; root.navigate(3); } }
                                CheckRow { text: "Your letterhead"; hint: "Upload the image your lab already uses"; done: root.setup-letterhead; clicked => { root.s-tab = root.is-admin ? 1 : 5; root.navigate(3); } }
                                CheckRow { text: "Doctor's signature"; hint: "Appears under the report"; done: root.setup-signature; clicked => { root.s-tab = root.is-admin ? 1 : 5; root.navigate(3); } }
                                CheckRow { text: "Your tests and prices"; hint: "Add or import the tests your lab offers"; done: root.setup-tests; clicked => { root.s-tab = root.is-admin ? 2 : 5; root.navigate(3); } }
                            }
                        }
                    }
                }
            }

            // ===== NEW PATIENT =====
            if root.page == 1: PageIn {
                HorizontalLayout {
                    padding: 24px; spacing: 20px;
                    Panel {
                        width: 440px;
                        ScrollView {
                            VerticalLayout {
                                padding: 22px; padding-bottom: 28px; spacing: 12px; alignment: start;
                                Micro { text: "01 / PATIENT"; color: Theme.blue; }
                                if root.f-linked == 0: VerticalLayout { spacing: 6px;
                                    Field { label: "Been here before? Find the patient"; placeholder: "Type a name, phone number or patient ID"; text <=> root.f-find; edited(t) => { root.find-edited(t); } }
                                    for r in root.find-results: Rectangle {
                                        height: 50px; background: fr.has-hover ? Theme.hover : Theme.paper; border-width: 1px; border-color: Theme.line;
                                        animate background { duration: Theme.quick; }
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                                            VerticalLayout { horizontal-stretch: 1; alignment: center;
                                                Text { text: r.name; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
                                                Text { text: r.meta; font-size: 11px; color: Theme.muted; overflow: elide; }
                                            }
                                            Text { text: r.visits; font-family: Theme.mono; font-size: 11px; color: Theme.blue; vertical-alignment: center; }
                                        }
                                        fr := TouchArea { clicked => { root.pick-patient(r.id); } mouse-cursor: pointer; }
                                    }
                                }
                                if root.f-linked != 0: Rectangle {
                                    height: 64px; background: #2f5bd610; border-width: 1px; border-color: Theme.blue;
                                    HorizontalLayout { padding: 12px; spacing: 10px;
                                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                            Micro { text: "RETURNING PATIENT"; color: Theme.blue; }
                                            Text { text: root.f-linked-text; font-size: 13px; color: Theme.ink; overflow: elide; }
                                        }
                                        VerticalLayout { alignment: center; Btn { text: "NOT THIS PERSON"; height: 30px; clicked => { root.unlink-patient(); } } }
                                    }
                                }
                                if root.f-linked == 0 && root.match-results.length > 0: VerticalLayout { spacing: 6px;
                                    Micro { text: "ALREADY REGISTERED? TAP THE PERSON IF THIS IS THEM"; color: Theme.amber; }
                                    for r in root.match-results: Rectangle {
                                        height: 50px; background: mr.has-hover ? Theme.hover : #b5791a14; border-width: 1px; border-color: Theme.amber;
                                        animate background { duration: Theme.quick; }
                                        HorizontalLayout { padding-left: 12px; padding-right: 12px; spacing: 8px;
                                            VerticalLayout { horizontal-stretch: 1; alignment: center;
                                                Text { text: r.name; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
                                                Text { text: r.meta; font-size: 11px; color: Theme.muted; overflow: elide; }
                                            }
                                            Text { text: r.visits; font-family: Theme.mono; font-size: 11px; color: Theme.blue; vertical-alignment: center; }
                                        }
                                        mr := TouchArea { clicked => { root.pick-patient(r.id); } mouse-cursor: pointer; }
                                    }
                                }
                                PatientForm {
                                    lock-name: root.f-linked != 0; lock-gender: root.f-linked != 0;
                                    first <=> root.f-first; last <=> root.f-last; age <=> root.f-age; age-type <=> root.f-age-type; gender <=> root.f-gender;
                                    phone <=> root.f-phone; email <=> root.f-email; address <=> root.f-address; ref-mode <=> root.f-ref; doctor <=> root.f-doctor;
                                    err-first <=> root.err-first; err-age <=> root.err-age; err-address <=> root.err-address; err-email <=> root.err-email; err-doctor <=> root.err-doctor;
                                    suggestions: root.doctor-suggestions;
                                    doctor-edited(t) => { root.doctor-edited(t); }
                                }
                            }
                        }
                    }
                    Panel {
                        horizontal-stretch: 1;
                        VerticalLayout {
                            padding: 22px; spacing: 12px;
                            HorizontalLayout {
                                Micro { text: "02 / TESTS"; color: Theme.pink; vertical-alignment: center; }
                                Rectangle { horizontal-stretch: 1; }
                                Micro { text: root.selected-count + " SELECTED"; color: root.selected-count > 0 ? Theme.ink : Theme.muted; vertical-alignment: center; }
                            }
                            Field { placeholder: "Search tests by name or code"; text <=> root.test-query; edited(t) => { root.test-query-edited(t); } }
                            if root.err-tests != "": Rectangle {
                                height: 38px; background: #b3261e14; border-width: 1px; border-color: Theme.red;
                                Text { x: 12px; text: root.err-tests; color: Theme.red; font-size: 13px; font-weight: 600; vertical-alignment: center; }
                            }
                            Rectangle {
                                vertical-stretch: 1; border-width: 1px; border-color: Theme.line; clip: true;
                                ScrollView {
                                    VerticalLayout {
                                        for t in root.tests: Rectangle {
                                            height: 42px;
                                            background: t.selected ? Theme.ink : (row-ta.has-hover ? Theme.hover : transparent);
                                            animate background { duration: Theme.quick; }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-left: 14px; padding-right: 14px; spacing: 12px;
                                                Rectangle {
                                                    width: 18px; height: 18px; y: (parent.height - self.height) / 2;
                                                    border-width: 2px; border-color: t.selected ? white : Theme.line; background: t.selected ? white : transparent;
                                                    animate background { duration: Theme.quick; }
                                                    if t.selected: Tick { tone: Theme.ink; x: 2px; y: 2px; width: 10px; height: 10px; }
                                                // }
                                                }
                                                Text { text: t.code; width: 70px; font-family: Theme.mono; font-size: 12px; color: t.selected ? white : Theme.muted; vertical-alignment: center; overflow: elide; }
                                                Text { text: t.name; horizontal-stretch: 1; font-size: 14px; color: t.selected ? white : Theme.ink; vertical-alignment: center; overflow: elide; }
                                                Text { text: t.dept; width: 140px; font-family: Theme.mono; font-size: 10px; letter-spacing: 1px; color: t.selected ? white : Theme.muted; vertical-alignment: center; overflow: elide; }
                                                Text { text: t.price; width: 70px; horizontal-alignment: right; font-family: Theme.mono; font-size: 13px; color: t.selected ? white : Theme.ink; vertical-alignment: center; }
                                            }
                                            row-ta := TouchArea { clicked => { root.toggle-test(t.id); } mouse-cursor: pointer; }
                                        }
                                        if root.tests.length == 0: Rectangle {
                                            height: 110px;
                                            Text { text: "No tests yet. Add your tests in Settings."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Panel {
                        width: 300px;
                        VerticalLayout {
                            padding: 22px; spacing: 12px; alignment: start;
                            Micro { text: "03 / BILL"; color: Theme.green; }
                            HorizontalLayout { Micro { text: "SUBTOTAL"; } Rectangle { horizontal-stretch: 1; } Text { text: root.bill-subtotal; font-family: Theme.mono; font-size: 14px; color: Theme.ink; } }
                            Field { label: "Discount (₹)"; text <=> root.f-discount; mono: true; numeric: true; edited(_) => { root.bill-changed(); } }
                            HorizontalLayout { Micro { text: "TOTAL"; vertical-alignment: center; } Rectangle { horizontal-stretch: 1; } Text { text: root.bill-total; font-family: Theme.mono; font-size: 24px; font-weight: 700; color: Theme.ink; } }
                            Field { label: "Paid now (₹)"; text <=> root.f-paid; mono: true; numeric: true; edited(_) => { root.bill-changed(); } }
                            Seg { label: "Paid by"; options: ["Cash", "UPI", "Card", "Bank"]; index <=> root.f-method; }
                            HorizontalLayout { Micro { text: "BALANCE DUE"; } Rectangle { horizontal-stretch: 1; } Text { text: root.bill-due; font-family: Theme.mono; font-size: 14px; color: Theme.red; } }
                            Rectangle { height: 6px; }
                            Btn { text: "REGISTER PATIENT"; primary: true; clicked => { root.register(); } }
                        }
                    }
                }
            }

            // ===== REPORTS =====
            if root.page == 2: PageIn {
                VerticalLayout {
                    padding: 24px; spacing: 14px;
                    HorizontalLayout {
                        spacing: 8px; height: 36px;
                        for f[i] in root.filter-labels: Rectangle {
                            width: fl.preferred-width + 28px;
                            background: root.filter-index == i ? Theme.ink : (fa.has-hover ? Theme.hover : transparent);
                            animate background { duration: Theme.quick; }
                            border-width: 1px; border-color: root.filter-index == i ? Theme.ink : Theme.line;
                            fl := Text { text: f; color: root.filter-index == i ? white : Theme.ink; font-family: Theme.mono; font-size: 11px; font-weight: 700; letter-spacing: 1.4px; horizontal-alignment: center; vertical-alignment: center; }
                            fa := TouchArea { clicked => { root.filter-index = i; root.refresh-orders(); } mouse-cursor: pointer; }
                        }
                        Rectangle { horizontal-stretch: 1; }
                        if root.can-money: Btn { text: "SUMMARY & EXPORT"; height: 36px; clicked => { root.sm-open(); } }
                        Rectangle {
                            width: 320px; border-width: 1px; border-color: q.has-focus ? Theme.ink : Theme.line; background: Theme.paper;
                            animate border-color { duration: Theme.quick; }
                            HorizontalLayout {
                                padding-left: 10px; padding-right: 10px;
                                q := TextInput { text <=> root.order-query; font-size: 14px; color: Theme.ink; vertical-alignment: center; edited => { root.refresh-orders(); } }
                            }
                            if q.text == "": Text { x: 10px; text: "Search name, ID, phone, or scan a report QR"; color: #a9a59b; font-size: 14px; vertical-alignment: center; }
                        }
                    }
                    Panel {
                        vertical-stretch: 1; clip: true;
                        VerticalLayout {
                            Rectangle {
                                height: 34px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Micro { text: "PATIENT ID"; width: 100px; vertical-alignment: center; }
                                    Micro { text: "NAME"; width: 220px; vertical-alignment: center; }
                                    Micro { text: "TESTS"; horizontal-stretch: 1; vertical-alignment: center; }
                                    Micro { text: "STATUS"; width: 100px; vertical-alignment: center; }
                                    Micro { text: "BILL"; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                    Micro { text: "DUE"; width: 90px; horizontal-alignment: right; vertical-alignment: center; }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    for o in root.orders: Rectangle {
                                        height: 52px;
                                        background: ra.has-hover ? Theme.hover : transparent;
                                        animate background { duration: Theme.quick; }
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                                            Text { text: o.code; width: 100px; font-family: Theme.mono; font-size: 13px; color: Theme.ink; vertical-alignment: center; }
                                            VerticalLayout {
                                                width: 220px; alignment: center;
                                                Text { text: o.name; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
                                                Text { text: o.age-gender + "  ·  " + o.when; font-size: 11px; color: Theme.muted; overflow: elide; }
                                            }
                                            Text { text: o.tests; horizontal-stretch: 1; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                            Rectangle { width: 100px; StatusChip { status: o.status; x: 0px; } }
                                            Text { text: o.total; width: 90px; horizontal-alignment: right; font-family: Theme.mono; font-size: 13px; color: Theme.ink; vertical-alignment: center; }
                                            Text { text: o.due; width: 90px; horizontal-alignment: right; font-family: Theme.mono; font-size: 13px; color: o.due == "—" ? Theme.muted : Theme.red; vertical-alignment: center; }
                                        }
                                        ra := TouchArea { clicked => { root.open-order(o.id); } mouse-cursor: pointer; }
                                    }
                                    if root.orders.length == 0: Rectangle {
                                        height: 160px;
                                        VerticalLayout {
                                            alignment: center; spacing: 6px;
                                            Text { text: "Nothing to show here yet"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                            Text { text: "Register a patient and the report will appear in this list."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== PATIENTS =====
            if root.page == 6: PageIn {
                HorizontalLayout {
                    padding: 24px; spacing: 20px;
                    Panel {
                        width: 390px;
                        VerticalLayout {
                            padding: 18px; spacing: 12px;
                            Micro { text: "ALL PATIENTS"; color: Theme.blue; }
                            Field { placeholder: "Search name, patient ID or phone"; text <=> root.pat-query; edited(_) => { root.pat-query-edited(); } }
                            Rectangle {
                                vertical-stretch: 1; border-width: 1px; border-color: Theme.line; clip: true;
                                ScrollView {
                                    VerticalLayout {
                                        for r in root.pat-list: Rectangle {
                                            height: 62px;
                                            background: root.pat-selected == r.id ? Theme.ink : (pa.has-hover ? Theme.hover : transparent);
                                            animate background { duration: Theme.quick; }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout { padding-left: 14px; padding-right: 14px; spacing: 8px;
                                                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                    Text { text: r.name; font-size: 14px; font-weight: 600; color: root.pat-selected == r.id ? white : Theme.ink; overflow: elide; }
                                                    Text { text: r.meta; font-size: 11px; color: root.pat-selected == r.id ? #d8d4ca : Theme.muted; overflow: elide; }
                                                }
                                                VerticalLayout { alignment: center; spacing: 2px; width: 70px;
                                                    Text { text: r.visits; font-family: Theme.mono; font-size: 11px; font-weight: 700; color: root.pat-selected == r.id ? white : Theme.blue; horizontal-alignment: right; }
                                                    Text { text: r.last; font-size: 10px; color: root.pat-selected == r.id ? #d8d4ca : Theme.muted; horizontal-alignment: right; }
                                                }
                                            }
                                            pa := TouchArea { clicked => { root.pick-pat(r.id); } mouse-cursor: pointer; }
                                        }
                                        if root.pat-list.length == 0: Rectangle {
                                            height: 120px;
                                            Text { text: "No patients found."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.pat-selected == 0: Panel {
                            VerticalLayout { alignment: center; spacing: 6px;
                                Text { text: "Choose a patient on the left"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                Text { text: "You will see every visit, the tests done and the money, in one place."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                            }
                        }
                        if root.pat-selected != 0: ScrollView {
                            VerticalLayout { spacing: 16px; alignment: start; padding-right: 8px;
                                if root.verdict-kind != 0: VerdictBar { kind: root.verdict-kind; text: root.verdict-text; can-open: root.verdict-order != 0; open => { root.open-order(root.verdict-order); } dismiss => { root.verdict-dismiss(); } }
                                Panel { height: 96px;
                                    HorizontalLayout { padding: 20px; spacing: 12px;
                                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                                            Text { text: root.pat-name; font-size: 22px; font-weight: 700; color: Theme.ink; overflow: elide; }
                                            Text { text: root.pat-meta; font-size: 12px; color: Theme.muted; overflow: elide; }
                                            Text { text: root.pat-contact; font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        VerticalLayout { alignment: center; Btn { text: "PRINT FULL BILL"; tone: Theme.blue; clicked => { root.print-full-bill(); } } }
                                        if root.pat-can-pay: VerticalLayout { alignment: center; Btn { text: "RECEIVE PAYMENT"; tone: Theme.green; clicked => { root.pay-open-patient(); } } }
                                        VerticalLayout { alignment: center; Btn { text: "+  NEW VISIT"; primary: true; clicked => { root.new-visit(); } } }
                                    }
                                }
                                HorizontalLayout { spacing: 12px;
                                    Mini { label: "VISITS"; value: root.pat-visits; hint: "times at this lab"; tone: Theme.blue; }
                                    Mini { label: "FIRST VISIT"; value: root.pat-first; }
                                    Mini { label: "LAST VISIT"; value: root.pat-last; }
                                    Mini { label: "TOTAL BILLED"; value: root.pat-billed; hint: "paid " + root.pat-paid; }
                                    Mini { label: "STILL DUE"; value: root.pat-due; tone: root.pat-has-due ? Theme.red : Theme.green; }
                                }
                                AutoPanel {
                                    Micro { text: "PAYMENTS RECEIVED  (every payment is saved here, newest first)"; color: Theme.green; }
                                    for y in root.pat-pays: Rectangle {
                                        height: 30px;
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        HorizontalLayout { spacing: 10px;
                                            Text { text: y.when; width: 150px; font-size: 12px; color: Theme.ink; vertical-alignment: center; }
                                            Text { text: y.how; horizontal-stretch: 1; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                            Text { text: y.bill; width: 90px; font-family: Theme.mono; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                                            Text { text: y.amount; width: 90px; font-family: Theme.mono; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                    if root.pat-pays.length == 0: Text { text: "No payment has been received yet."; font-size: 12px; color: Theme.muted; }
                                    if root.pat-pays.length > 0: Text { text: "Total received: " + root.pat-pays-total; font-size: 12px; font-weight: 700; color: Theme.ink; horizontal-alignment: right; }
                                }
                                if root.tr-names.length > 0: AutoPanel {
                                    Micro { text: "TREND: HOW A RESULT CHANGED ACROSS VISITS"; color: Theme.blue; }
                                    HorizontalLayout { spacing: 12px;
                                        VerticalLayout { width: 260px; Pick { text: root.tr-pick; options: root.tr-names; menu-width: 260px; picked(t) => { root.tr-choose(t); } } }
                                        Text { text: root.tr-range; font-size: 12px; color: Theme.muted; vertical-alignment: center; }
                                    }
                                    Rectangle {
                                        height: 190px;
                                        Rectangle { x: 0px; y: 10px; width: 640px; height: 160px; background: white; border-width: 1px; border-color: Theme.line; }
                                        // the normal range as a green band
                                        Rectangle { x: 1px; y: 10px + root.tr-band-top * 1px; width: 638px; height: root.tr-band-h * 1px; background: #1f7a4a22; }
                                        Path { x: 0px; y: 10px; width: 640px; height: 160px; viewbox-x: 0; viewbox-y: 0; viewbox-width: 640; viewbox-height: 160; commands: root.tr-path; stroke: Theme.ink; stroke-width: 2px; fill: transparent; }
                                        for pt in root.tr-points: Rectangle {
                                            x: pt.x * 1px - 5px; y: 10px + pt.y * 1px - 5px; width: 10px; height: 10px; border-radius: 5px;
                                            background: pt.bad ? Theme.red : Theme.ink;
                                        }
                                        for pt in root.tr-points: Text { x: pt.x * 1px - 45px; y: 172px; width: 90px; text: pt.label; font-size: 10px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                                    }
                                }
                                AutoPanel {
                                    Micro { text: "TESTS DONE, MOST OFTEN FIRST"; color: Theme.pink; }
                                    for c in root.pat-tests: Rectangle {
                                        height: 30px;
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        HorizontalLayout { spacing: 10px;
                                            Text { text: c.name; horizontal-stretch: 1; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                            Text { text: c.times; width: 60px; font-family: Theme.mono; font-size: 13px; font-weight: 700; color: Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: c.last; width: 110px; font-size: 12px; color: Theme.muted; horizontal-alignment: right; vertical-alignment: center; }
                                        }
                                    }
                                }
                                AutoPanel {
                                    Micro { text: "EVERY VISIT, NEWEST FIRST  (click a visit to open its report)"; color: Theme.green; }
                                    VerticalLayout {
                                        for r in root.pat-tree: Rectangle {
                                            height: r.kind == 0 ? 54px : 28px;
                                            background: vis-ta.has-hover ? Theme.hover : transparent;
                                            animate background { duration: Theme.quick; }
                                            // the tree: one vertical line, a dot for each visit, a short branch for each test
                                            Rectangle { x: 13px; width: 2px; background: Theme.line; }
                                            if r.kind == 0: Rectangle { x: 8px; y: 20px; width: 12px; height: 12px; border-radius: 6px; background: Theme.ink; }
                                            if r.kind == 1: Rectangle { x: 14px; y: parent.height / 2 - 1px; width: 22px; height: 2px; background: Theme.line; }
                                            if r.kind == 0: HorizontalLayout { padding-left: 36px; padding-right: 8px; spacing: 10px;
                                                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                    Text { text: r.title; font-size: 14px; font-weight: 700; color: Theme.ink; overflow: elide; }
                                                    Text { text: r.sub; font-size: 11px; color: Theme.muted; overflow: elide; }
                                                }
                                                Text { text: r.right; font-family: Theme.mono; font-size: 12px; color: r.tone == 3 ? Theme.red : Theme.ink; vertical-alignment: center; }
                                                Rectangle { width: 84px; StatusChip { status: r.status; y: (parent.height - self.height) / 2; } }
                                            }
                                            if r.kind == 1: HorizontalLayout { padding-left: 46px; padding-right: 8px; spacing: 10px;
                                                Text { text: r.title; horizontal-stretch: 1; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                                Text { text: r.right; font-size: 11px; font-weight: 600; color: r.tone == 3 ? Theme.red : r.tone == 1 ? Theme.green : Theme.muted; vertical-alignment: center; }
                                            }
                                            vis-ta := TouchArea { enabled: r.kind == 0; clicked => { root.open-order(r.order-id); } mouse-cursor: pointer; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== SCAN =====
            if root.page == 7: PageIn {
                init => { scan-in.focus(); }
                HorizontalLayout {
                    padding: 24px; spacing: 20px;
                    Panel {
                        width: 400px;
                        VerticalLayout {
                            padding: 22px; spacing: 14px; alignment: start;
                            Micro { text: "SCAN A REPORT"; color: Theme.blue; }
                            Text { text: "Scan the QR code on a printed report"; font-size: 20px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                            Text { text: "Plug in the scanner, click the box below, then scan. The patient and the report appear here at once, and LabDesk tells you if the paper is genuine."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                            Rectangle {
                                height: 64px; background: white; border-width: 2px; border-color: Theme.green;
                                HorizontalLayout { padding: 14px; spacing: 12px;
                                    VerticalLayout { width: 12px; alignment: center; Rectangle { height: 12px; border-radius: 6px; background: Theme.green; } }
                                    scan-in := Field { placeholder: "Ready: scan now"; mono: true; text <=> root.scan-input; edited(t) => { root.scan-edited(t); } accepted => { root.scan-submit(); } }
                                }
                            }
                            Text { text: "Nothing happens when I scan?"; font-size: 12px; font-weight: 700; color: Theme.ink; }
                            Text { text: "1. Click inside the green box first.\n2. A USB scanner works like a keyboard, so no driver is needed.\n3. Scanned text should appear in the box. If it does not, check the cable.\n4. A phone camera also works: it just will not type into LabDesk."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                            HorizontalLayout { spacing: 8px; alignment: start;
                                Btn { text: "CLEAR"; clicked => { root.scan-clear(); scan-in.focus(); } }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.sc-kind == 0: Panel {
                            VerticalLayout { alignment: center; spacing: 8px;
                                HorizontalLayout { alignment: center;
                                Rectangle { width: 84px; height: 84px; border-width: 3px; border-color: Theme.line;
                                    Rectangle { x: 14px; y: 14px; width: 18px; height: 18px; background: Theme.line; }
                                    Rectangle { x: 52px; y: 14px; width: 18px; height: 18px; background: Theme.line; }
                                    Rectangle { x: 14px; y: 52px; width: 18px; height: 18px; background: Theme.line; }
                                    Rectangle { x: 46px; y: 46px; width: 8px; height: 8px; background: Theme.line; }
                                    Rectangle { x: 62px; y: 58px; width: 8px; height: 8px; background: Theme.line; }
                                }
                                }
                                Text { text: "Waiting for a scan"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                Text { text: "The patient's details will appear here."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                            }
                        }
                        if root.sc-kind != 0: ScrollView {
                            VerticalLayout { spacing: 14px; alignment: start; padding-right: 8px;
                                VerdictBar { kind: root.sc-kind == 1 ? 1 : 2; text: root.sc-text; can-open: false; dismiss => { root.scan-clear(); scan-in.focus(); } }
                                if root.sc-kind != 3: Panel { height: 96px;
                                    HorizontalLayout { padding: 20px; spacing: 12px;
                                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                                            Text { text: root.sc-name; font-size: 22px; font-weight: 700; color: Theme.ink; overflow: elide; }
                                            Text { text: root.sc-meta; font-size: 12px; color: Theme.muted; overflow: elide; }
                                            Text { text: root.sc-contact; font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        VerticalLayout { alignment: center; spacing: 6px; StatusChip { status: root.sc-status; x: parent.width - self.width; } Micro { text: root.sc-money; horizontal-alignment: right; } }
                                    }
                                }
                                if root.sc-kind != 3: HorizontalLayout { spacing: 8px; alignment: start;
                                    Btn { text: "OPEN THIS REPORT"; primary: true; clicked => { root.open-order(root.sc-order); } }
                                    Btn { text: "PATIENT HISTORY"; clicked => { root.open-patient(root.sc-patient); } }
                                    Btn { text: "SCAN NEXT"; clicked => { root.scan-clear(); scan-in.focus(); } }
                                }
                                if root.sc-kind != 3: AutoPanel {
                                    Micro { text: "WHAT THE LAB APPROVED FOR THIS REPORT"; color: Theme.pink; }
                                    for r in root.sc-rows: Rectangle {
                                        height: r.kind == 0 ? 34px : 28px;
                                        background: r.kind == 0 ? Theme.bg : transparent;
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        if r.kind == 0: Text { x: 8px; text: r.name; font-size: 13px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                                        if r.kind == 1: HorizontalLayout { padding-left: 14px; padding-right: 8px; spacing: 10px;
                                            Text { text: r.name; horizontal-stretch: 1; font-size: 13px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                            Text { text: r.value; width: 130px; font-family: Theme.mono; font-size: 13px; font-weight: 700; color: r.flag == "Critical" ? Theme.red : r.flag != "" ? Theme.amber : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                                            Text { text: r.range; width: 150px; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                            Text { text: r.flag; width: 60px; font-size: 11px; font-weight: 700; color: r.flag == "Critical" ? Theme.red : Theme.amber; vertical-alignment: center; }
                                        }
                                    }
                                }
                                if root.sc-kind == 3: Btn { text: "SCAN NEXT"; clicked => { root.scan-clear(); scan-in.focus(); } }
                            }
                        }
                    }
                }
            }

            // ===== ANALYTICS =====
            if root.page == 9: PageIn { ScrollView {
                VerticalLayout {
                    padding: 28px; padding-top: 24px; spacing: 18px; alignment: start;
                    VerticalLayout { spacing: 2px;
                        Text { text: "Analytics"; font-size: 30px; font-weight: 700; color: Theme.ink; }
                        Text { text: "How busy the lab is and where the money comes from. Only Admin and Reception can see this page."; font-size: 13px; color: Theme.muted; }
                    }
                    Micro { text: "TODAY, COMPARED WITH YESTERDAY"; color: Theme.blue; }
                    HorizontalLayout { spacing: 14px;
                        for k in root.an-today: AnCard { label: k.label; value: k.value; change: k.change; tone: k.tone; }
                    }
                    Rectangle { height: 2px; }
                    Rectangle {
                        background: Theme.paper; border-width: 1px; border-color: Theme.line; height: 76px;
                        HorizontalLayout { padding: 14px; spacing: 10px; alignment: start;
                            VerticalLayout { alignment: center; Micro { text: "CHOOSE THE DAYS"; } }
                            VerticalLayout { alignment: center; Btn { text: "LAST 7 DAYS"; height: 32px; primary: root.an-sel == 0; clicked => { root.an-range(0); } } }
                            VerticalLayout { alignment: center; Btn { text: "LAST 30 DAYS"; height: 32px; primary: root.an-sel == 1; clicked => { root.an-range(1); } } }
                            VerticalLayout { alignment: center; Btn { text: "THIS MONTH"; height: 32px; primary: root.an-sel == 2; clicked => { root.an-range(2); } } }
                            VerticalLayout { alignment: center; Btn { text: "THIS YEAR"; height: 32px; primary: root.an-sel == 3; clicked => { root.an-range(3); } } }
                            Rectangle { width: 14px; }
                            Field { width: 150px; label: "From"; text <=> root.an-from; mono: true; error: root.err-an; edited(_) => { root.err-an = ""; root.an-sel = -1; } }
                            Field { width: 150px; label: "To"; text <=> root.an-to; mono: true; edited(_) => { root.err-an = ""; root.an-sel = -1; } }
                            VerticalLayout { alignment: end; Btn { text: "SHOW"; primary: true; tone: Theme.blue; height: 36px; clicked => { root.an-run(); } } }
                        }
                    }
                    Text { text: root.an-title; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout { spacing: 14px;
                        for k in root.an-kpis: AnCard { label: k.label; value: k.value; change: k.change; tone: k.tone; }
                    }
                    Text { text: root.an-people; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                    HorizontalLayout { spacing: 14px;
                        AnBox { title: "MONEY: BILLED (LIGHT) AND RECEIVED (DARK)"; tone: Theme.green;
                            AnChart { bars: root.an-money; tone: Theme.green; top-note: root.an-money-top; note: root.an-money-note; } }
                        AnBox { title: "TESTS (LIGHT) AND PATIENTS (DARK)"; tone: Theme.blue;
                            AnChart { bars: root.an-visits; tone: Theme.blue; top-note: root.an-visits-top; note: root.an-visits-note; } }
                    }
                    HorizontalLayout { spacing: 14px;
                        AnBox { title: "HOW PEOPLE PAID"; tone: Theme.amber; AnBars { rows: root.an-methods; tone: Theme.amber; } }
                        AnBox { title: "BY DEPARTMENT (TESTS DONE)"; tone: Theme.pink; AnBars { rows: root.an-depts; tone: Theme.pink; } }
                        AnBox { title: "WHEN PATIENTS ARRIVE (HOUR OF THE DAY)"; tone: Theme.blue;
                            AnChart { height: 190px; bars: root.an-hours; tone: Theme.blue; top-note: ""; note: root.an-hours-note; } }
                    }
                    HorizontalLayout { spacing: 14px;
                        AnBox { title: "MOST DONE TESTS"; tone: Theme.green; AnBars { rows: root.an-tests; tone: Theme.green; } }
                        AnBox { title: "BY REFERRING DOCTOR (MONEY BILLED)"; tone: Theme.blue; AnBars { rows: root.an-docs; tone: Theme.blue; } }
                    }
                    Rectangle { height: 10px; }
                }
            } }

            // ===== ANALYZER RESULTS =====
            if root.page == 8: PageIn {
                HorizontalLayout {
                    padding: 24px; spacing: 20px;
                    Panel {
                        width: 360px;
                        VerticalLayout {
                            padding: 18px; spacing: 12px;
                            Micro { text: "RESULTS FROM THE ANALYZER"; color: Theme.pink; }
                            Rectangle {
                                vertical-stretch: 1; border-width: 1px; border-color: Theme.line; clip: true;
                                ScrollView {
                                    VerticalLayout {
                                        for r in root.mach-list: Rectangle {
                                            height: 62px;
                                            background: root.mach-selected == r.id ? Theme.ink : (ma.has-hover ? Theme.hover : transparent);
                                            animate background { duration: Theme.quick; }
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout { padding-left: 14px; padding-right: 12px; spacing: 8px;
                                                VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                    Text { text: r.name; font-size: 14px; font-weight: 600; color: root.mach-selected == r.id ? white : Theme.ink; overflow: elide; }
                                                    Text { text: "Sample " + r.sample + "  ·  " + r.time; font-size: 11px; color: root.mach-selected == r.id ? #d8d4ca : Theme.muted; overflow: elide; }
                                                }
                                                VerticalLayout { alignment: center; spacing: 3px; width: 74px;
                                                    Text { text: r.status; font-family: Theme.mono; font-size: 10px; font-weight: 700; color: r.status == "NEW" ? Theme.pink : root.mach-selected == r.id ? #d8d4ca : Theme.muted; horizontal-alignment: right; }
                                                    Text { text: r.abn; font-size: 10px; color: root.mach-selected == r.id ? #d8d4ca : Theme.muted; horizontal-alignment: right; }
                                                }
                                            }
                                            ma := TouchArea { clicked => { root.mach-pick(r.id); } mouse-cursor: pointer; }
                                        }
                                        if root.mach-list.length == 0: Rectangle {
                                            height: 150px;
                                            Text { text: "Nothing has arrived yet.\nTurn on receiving in Settings → Integrated machines."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }
                        }
                    }
                    Rectangle {
                        horizontal-stretch: 1;
                        if root.mach-selected == 0: Panel {
                            VerticalLayout { alignment: center; spacing: 6px;
                                Text { text: "Choose a result on the left"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                Text { text: "You will see every value and the three graphs, and you can attach it to a patient's report."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                            }
                        }
                        if root.mach-selected != 0: ScrollView {
                            VerticalLayout { spacing: 14px; alignment: start; padding-right: 8px;
                                Panel { height: 86px;
                                    HorizontalLayout { padding: 18px; spacing: 12px;
                                        VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 3px;
                                            Text { text: root.md-name; font-size: 21px; font-weight: 700; color: Theme.ink; overflow: elide; }
                                            Text { text: root.md-meta; font-size: 12px; color: Theme.muted; overflow: elide; }
                                        }
                                        if root.md-new: VerticalLayout { alignment: center; Btn { text: "DISMISS"; clicked => { root.mach-dismiss(); } } }
                                        VerticalLayout { alignment: center; StatusChip { status: root.md-status; } }
                                    }
                                }
                                if root.md-note != "": Text { text: root.md-note; font-size: 13px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                                if root.md-order != 0: AutoPanel {
                                    Micro { text: "THE REPORT IS READY"; color: Theme.green; }
                                    HorizontalLayout { spacing: 10px; alignment: start;
                                        Btn { text: "EDIT REPORT"; clicked => { root.mach-edit(); } }
                                        if root.mach-can-approve: Btn { text: "APPROVE & PRINT"; primary: true; tone: Theme.green; clicked => { root.mach-print(); } }
                                    }
                                    if !root.mach-can-approve: Text { text: "A doctor (or the Admin) approves the report; then it can be printed from the report screen."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                }
                                if root.md-new: AutoPanel {
                                    Micro { text: "NEW PATIENT FROM THIS RESULT  (one step)"; color: Theme.green; }
                                    Field { label: "Name"; text <=> root.qp-name; error: root.err-qp; edited(_) => { root.err-qp = ""; } }
                                    HorizontalLayout { spacing: 10px;
                                        Field { label: "Age (years)"; numeric: true; text <=> root.qp-age; width: 120px; }
                                        Seg { label: "Gender"; options: ["Male", "Female", "Other"]; index <=> root.qp-gender; horizontal-stretch: 1; }
                                        Field { label: "Phone (optional)"; text <=> root.qp-phone; width: 200px; }
                                    }
                                    HorizontalLayout { alignment: start; Btn { text: "CREATE REPORT"; primary: true; tone: Theme.green; clicked => { root.mach-quick(); } } }
                                    Text { text: "Makes the patient and the blood count report and fills in every value. You can still change anything."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                }
                                if root.md-new: AutoPanel {
                                    Micro { text: "OR ATTACH TO A REPORT ALREADY REGISTERED  (best match first)"; color: Theme.green; }
                                    for c in root.md-cands: Rectangle {
                                        height: 52px;
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        HorizontalLayout { spacing: 10px;
                                            VerticalLayout { horizontal-stretch: 1; alignment: center; spacing: 2px;
                                                Text { text: c.title; font-size: 13px; font-weight: 700; color: Theme.ink; overflow: elide; }
                                                Text { text: c.sub; font-size: 11px; color: Theme.muted; overflow: elide; }
                                            }
                                            Text { text: c.hint; font-size: 11px; font-weight: 700; color: Theme.green; vertical-alignment: center; }
                                            VerticalLayout { alignment: center; Btn { text: "ATTACH"; primary: true; tone: Theme.green; height: 30px; clicked => { root.mach-attach(c.order-test-id); } } }
                                        }
                                    }
                                    if root.md-cands.length == 0: Text { text: "No report with \"Complete Blood Count (analyzer)\" is waiting. Use CREATE REPORT above, or register the patient with that test."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                }
                                HorizontalLayout { spacing: 14px;
                                    Panel { horizontal-stretch: 3; preferred-height: mt.preferred-height + 8px;
                                        mt := VerticalLayout { padding: 14px; spacing: 0px;
                                            Rectangle { height: 26px;
                                                HorizontalLayout { spacing: 10px;
                                                    Micro { text: "ITEM"; horizontal-stretch: 1; }
                                                    Micro { text: "RESULT"; width: 70px; horizontal-alignment: right; }
                                                    Micro { text: "UNIT"; width: 62px; }
                                                    Micro { text: "RANGE"; width: 92px; }
                                                    Micro { text: "HIT"; width: 24px; }
                                                }
                                            }
                                            for r in root.md-items: Rectangle {
                                                height: 25px;
                                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                                HorizontalLayout { spacing: 10px;
                                                    Text { text: r.name; horizontal-stretch: 1; font-size: 12px; color: Theme.ink; vertical-alignment: center; }
                                                    Text { text: r.value; width: 70px; font-family: Theme.mono; font-size: 12px; font-weight: 700; color: r.flag != "" ? Theme.red : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                                                    Text { text: r.unit; width: 62px; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                                                    Text { text: r.range; width: 92px; font-size: 11px; color: Theme.muted; vertical-alignment: center; }
                                                    Text { text: r.flag; width: 24px; font-size: 11px; font-weight: 800; color: Theme.red; vertical-alignment: center; }
                                                }
                                            }
                                        }
                                    }
                                    VerticalLayout { horizontal-stretch: 2; spacing: 12px; alignment: start;
                                        for h in root.md-hists: Rectangle {
                                            height: 120px; background: #14203a; border-width: 1px; border-color: Theme.ink;
                                            Micro { x: parent.width - 40px; y: 4px; text: h.name; color: #c9d3ea; font-size: 10px; }
                                            Rectangle { x: 10px; y: 18px; width: parent.width - 20px; height: parent.height - 28px;
                                                Path { width: parent.width; height: parent.height; viewbox-width: 256; viewbox-height: 100; commands: h.path; fill: h.fill; stroke: #ffffff60; stroke-width: 1px; }
                                                for ln[k] in h.lines: Rectangle { x: ln * parent.width; width: 1px; height: parent.height; background: #e8e8e8;
                                                    Text { y: -12px; x: -10px; width: 22px; text: h.labels[k]; font-size: 8px; color: #c9d3ea; horizontal-alignment: center; } }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }
                }
            }

            // ===== SETTINGS =====
            if root.page == 3: PageIn {
                HorizontalLayout {
                    // ---- left menu ----
                    Rectangle {
                        width: 236px; background: Theme.paper;
                        Rectangle { x: parent.width - 1px; width: 1px; background: Theme.line; }
                        VerticalLayout {
                            padding: 18px; padding-right: 19px; spacing: 4px; alignment: start;
                            Micro { text: "SETTINGS"; color: Theme.ink; }
                            Rectangle { height: 8px; }
                            for idx in [0, 1, 2, 3, 4, 9, 8, 5, 6, 7]: Rectangle {
                                property <bool> shown: root.is-admin || (idx >= 5 && idx != 8 && idx != 9);
                                height: shown ? 42px : 0px;
                                visible: shown;
                                SideItem { text: ["Lab details", "Report paper", "Tests", "People & passwords", "Data & backup", "My account", "Help", "About", "Integrated machines", "Email"][idx]; active: root.s-tab == idx; clicked => { root.s-tab = idx; } }
                            }
                        }
                    }
                    // ---- content ----
                    Rectangle {
                        horizontal-stretch: 1;

                        if root.s-tab == 0: PageIn { ScrollView { HorizontalLayout { padding: 24px; spacing: 20px; alignment: start;
                        Panel {
                            width: 420px; height: 560px;
                            VerticalLayout {
                                padding: 22px; spacing: 12px; alignment: start;
                                Micro { text: "YOUR LAB"; color: Theme.blue; }
                                Field { label: "Lab name"; text <=> root.s-name; error: root.err-s-name; edited(_) => { root.err-s-name = ""; } }
                                Field { label: "Address"; text <=> root.s-address; }
                                Field { horizontal-stretch: 1; preferred-width: 0px; label: "Phone"; text <=> root.s-phone; mono: true; }
                                Field { label: "Email"; text <=> root.s-email; }
                                Field { label: "Doctor's name (under signature)"; text <=> root.s-signatory; }
                                Field { label: "Qualification / registration no."; text <=> root.s-qualification; }
                                Rectangle { height: 4px; }
                                Btn { text: "SAVE LAB DETAILS"; primary: true; clicked => { root.save-settings(); } }
                            }
                        }

                        } } }

                        if root.s-tab == 1: PageIn { ScrollView { HorizontalLayout { padding: 24px; spacing: 20px; alignment: start;
                        Panel {
                            width: 560px; height: 650px;
                            VerticalLayout {
                                padding: 22px; spacing: 14px; alignment: start;
                                Micro { text: "REPORT PAPER"; color: Theme.pink; }
                                HorizontalLayout {
                                    spacing: 18px; height: 232px;
                                    Rectangle {
                                        width: 164px; background: white; border-width: 1px; border-color: Theme.line; clip: true;
                                        if root.has-letterhead: Image { source: root.letterhead-img; image-fit: cover; width: parent.width; height: parent.height; }
                                        if !root.has-letterhead: Text { text: "No letterhead\nyet"; font-size: 12px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 10px; alignment: start;
                                        Text { text: "Letterhead"; font-size: 15px; font-weight: 700; color: Theme.ink; }
                                        Text { text: "Upload the image your lab already uses for printed reports (a full A4 page, PNG or JPG). LabDesk prints the patient details and results on top of it."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                        Btn { text: root.has-letterhead ? "CHANGE LETTERHEAD…" : "CHOOSE LETTERHEAD…"; clicked => { root.choose-letterhead(); } }
                                        if root.has-letterhead: Btn { text: "REMOVE"; tone: Theme.red; clicked => { root.remove-letterhead(); } }
                                    }
                                }
                                HorizontalLayout {
                                    spacing: 18px; height: 70px;
                                    Rectangle {
                                        width: 164px; background: white; border-width: 1px; border-color: Theme.line; clip: true;
                                        if root.has-signature: Image { source: root.signature-img; image-fit: contain; width: parent.width - 12px; height: parent.height - 8px; }
                                        if !root.has-signature: Text { text: "No signature yet"; font-size: 12px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                    VerticalLayout {
                                        spacing: 8px; alignment: center;
                                        Text { text: "Signature (PNG with transparent background looks best)"; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                        HorizontalLayout { spacing: 8px;
                                            Btn { text: root.has-signature ? "CHANGE…" : "CHOOSE…"; clicked => { root.choose-signature(); } }
                                            if root.has-signature: Btn { text: "REMOVE"; tone: Theme.red; clicked => { root.remove-signature(); } }
                                        }
                                    }
                                }
                                Seg { label: "Size of the printed results"; options: ["Smallest", "Smaller", "Normal", "Larger"]; index <=> root.s-size; }
                                Text { text: "If only the last lines would spill onto a second page, LabDesk makes the text a little smaller by itself."; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                Micro { text: "BLANK SPACE LEFT FOR YOUR LETTERHEAD (MM)"; }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Field { label: "Top"; text <=> root.s-top; mono: true; numeric: true; }
                                    Field { label: "Bottom"; text <=> root.s-bottom; mono: true; numeric: true; }
                                    Field { label: "Left"; text <=> root.s-left; mono: true; numeric: true; }
                                    Field { label: "Right"; text <=> root.s-right; mono: true; numeric: true; }
                                }
                                HorizontalLayout {
                                    spacing: 10px;
                                    Btn { text: "PRINT A TEST PAGE"; clicked => { root.print-test-page(); } }
                                    Btn { text: "SAVE PAPER SETTINGS"; primary: true; clicked => { root.save-settings(); } }
                                }
                            }
                        }
                        Panel {
                            width: 480px; height: 690px;
                            VerticalLayout {
                                padding: 22px; spacing: 12px; alignment: start;
                                Micro { text: "PATIENT DETAILS DESIGN"; color: Theme.pink; }
                                Text { text: "Choose how the patient box looks at the top of every report. It is saved as soon as you press a design. Press PRINT A TEST PAGE to see it on your letterhead."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                for row in 4: HorizontalLayout { spacing: 14px; alignment: start;
                                    HeaderThumb { design: row * 2; active: root.s-design == row * 2; name: (row * 2 + 1) + ".  " + ["Boxed", "Boxed, code in the middle", "Underline", "Heavy box", "Grey band", "Grey panel", "Plain", "Divider lines"][row * 2]; clicked => { root.pick-design(row * 2); } }
                                    HeaderThumb { design: row * 2 + 1; active: root.s-design == row * 2 + 1; name: (row * 2 + 2) + ".  " + ["Boxed", "Boxed, code in the middle", "Underline", "Heavy box", "Grey band", "Grey panel", "Plain", "Divider lines"][row * 2 + 1]; clicked => { root.pick-design(row * 2 + 1); } }
                                }
                            }
                        }

                        } } }

                        // ----- TESTS -----
                        if root.s-tab == 2: PageIn {
                            // the list of tests
                            if root.te-id == -1: HorizontalLayout {
                                padding: 24px; spacing: 20px; alignment: start;
                                Panel {
                                    width: 640px;
                                    VerticalLayout {
                                        Rectangle {
                                            height: 56px;
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 12px; spacing: 8px;
                                                VerticalLayout { alignment: center; Micro { text: "YOUR TESTS"; color: Theme.ink; } Text { text: root.test-count-text; font-size: 12px; color: Theme.muted; } }
                                                Rectangle { horizontal-stretch: 1; }
                                                VerticalLayout { alignment: center; Btn { text: "+ NEW TEST"; primary: true; height: 32px; clicked => { root.te-new(); } } }
                                            }
                                        }
                                        Rectangle {
                                            height: 62px;
                                            VerticalLayout { padding: 12px; padding-bottom: 10px; Field { placeholder: "Search by name or code"; text <=> root.te-query; edited(_) => { root.te-query-changed(); } } }
                                        }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                for t in root.tests-admin: ListItem {
                                                    title: t.name; sub: t.code + "  ·  " + t.dept + (t.off ? "  ·  SWITCHED OFF" : ""); side: t.price; dim: t.off; active: root.te-id == t.id;
                                                    clicked => { root.te-open(t.id); }
                                                }
                                                if root.tests-admin.length == 0: Rectangle { height: 120px; Text { text: "No tests found. Press STANDARD LIST below to add the lab's ready-made tests."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; wrap: word-wrap; } }
                                            }
                                        }
                                        Rectangle {
                                            height: 58px; background: Theme.bg;
                                            Rectangle { y: 0px; height: 1px; background: Theme.line; }
                                            HorizontalLayout { padding: 11px; spacing: 8px;
                                                Btn { text: "IMPORT…"; clicked => { root.import-tests(); } }
                                                Btn { text: "STANDARD LIST"; clicked => { root.load-samples(); } }
                                            }
                                        }
                                    }
                                }
                                VerticalLayout { width: 340px; padding-top: 6px; spacing: 6px; alignment: start;
                                    Text { text: "Choose a test to edit it"; font-size: 18px; font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                                    Text { text: "Open any test to change its fields, normal ranges (by age and gender), formulas and print order. Or press + NEW TEST."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                                    Text { text: "Changes apply to new patients. Reports already made are never altered."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                }
                            }
                            // the full test editor
                            if root.te-id != -1: ScrollView {
                              VerticalLayout {
                                padding: 20px; spacing: 14px; alignment: start;
                                HorizontalLayout { spacing: 10px; alignment: start;
                                    Btn { text: "←  BACK"; clicked => { root.te-back(); } }
                                    VerticalLayout { alignment: center; Micro { text: root.te-id == 0 ? "NEW TEST" : "EDIT TEST"; color: Theme.blue; } }
                                }
                                Panel {
                                    VerticalLayout {
                                        // title bar with the actions
                                        Rectangle {
                                            height: 64px;
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout { padding-left: 18px; padding-right: 14px; spacing: 8px;
                                                Rectangle { horizontal-stretch: 1; min-width: 60px; Text { width: parent.width; text: root.te-name == "" ? "New test" : root.te-name; font-size: 16px; font-weight: 700; color: Theme.ink; overflow: elide; vertical-alignment: center; } }
                                                VerticalLayout { alignment: center; width: 170px; Field { placeholder: "Copy from existing test"; text <=> root.te-copy-q; edited(_) => { root.te-copy-changed(); } } }
                                                VerticalLayout { alignment: center; Btn { text: "RESET TEST"; tone: Theme.red; height: 32px; clicked => { root.te-reset(); } } }
                                                VerticalLayout { alignment: center; Btn { text: "VIEW COMMENT"; height: 32px; clicked => { root.te-open-text(0); } } }
                                                VerticalLayout { alignment: center; Btn { text: "VIEW INTERPRETATION"; height: 32px; clicked => { root.te-open-text(1); } } }
                                                VerticalLayout { alignment: center; Btn { text: "PREVIEW REPORT"; height: 32px; clicked => { root.te-preview(); } } }
                                                VerticalLayout { alignment: center; Btn { text: "SAVE"; primary: true; height: 32px; clicked => { root.te-save(); } } }
                                            }
                                        }
                                        VerticalLayout {
                                            padding: 18px; spacing: 12px;
                                            HorizontalLayout { spacing: 12px;
                                                VerticalLayout { width: 120px; spacing: 4px; Micro { text: "TEST TYPE"; font-size: 10px; } Pick { text: root.te-type; options: ["Default", "Profile", "Culture"]; menu-width: 150px; picked(t) => { root.te-type = t; } } }
                                                HorizontalLayout { width: 210px; spacing: 0px;
                                                    Field { label: "Department *"; placeholder: "e.g. BIOCHEMISTRY"; text <=> root.te-dept; error: root.err-te-dept; edited(_) => { root.err-te-dept = ""; } }
                                                    VerticalLayout { alignment: end; padding-bottom: 1px; Pick { arrow-only: true; width: 28px; options: root.dept-choices; menu-width: 230px; picked(t) => { root.te-dept = t; root.err-te-dept = ""; } } }
                                                }
                                                Field { label: "Test name *"; placeholder: "e.g. LIVER FUNCTION TEST (LFT)"; text <=> root.te-name; error: root.err-te-name; edited(_) => { root.err-te-name = ""; } }
                                                Seg { label: "Gender *"; options: ["Male", "Female", "Both"]; index <=> root.te-gender; width: 180px; }
                                                Field { label: "Price (₹) *"; text <=> root.te-price; width: 90px; mono: true; numeric: true; error: root.err-te-price; edited(_) => { root.err-te-price = ""; } }
                                                Field { label: "Test code *"; placeholder: "e.g. LFT"; text <=> root.te-code; width: 100px; mono: true; error: root.err-te-code; edited(_) => { root.err-te-code = ""; } }
                                            }
                                            HorizontalLayout { spacing: 12px;
                                                HorizontalLayout { width: 170px; spacing: 0px;
                                                    Field { label: "Sample"; placeholder: "e.g. Serum"; text <=> root.te-sample; }
                                                    VerticalLayout { alignment: end; padding-bottom: 1px; Pick { arrow-only: true; width: 28px; options: root.sample-choices; menu-width: 190px; picked(t) => { root.te-sample = t; } } }
                                                }
                                                HorizontalLayout { width: 200px; spacing: 0px;
                                                    Field { label: "Sample colour"; placeholder: "Select"; text <=> root.te-color; }
                                                    VerticalLayout { alignment: end; padding-bottom: 1px; Pick { arrow-only: true; width: 28px; clearable: true; options: ["Red", "Yellow (gel)", "Lavender", "Light blue", "Green", "Grey", "Black", "White / plain"]; menu-width: 190px; picked(t) => { root.te-color = t; } } }
                                                }
                                                Field { label: "Barcode suffix"; placeholder: "Enter suffix"; text <=> root.te-suffix; }
                                                VerticalLayout { spacing: 8px; width: 330px;
                                                    Micro { text: "REQUIRED FIELDS"; font-size: 10px; }
                                                    HorizontalLayout { spacing: 14px; alignment: start;
                                                        Check { text: "LMP required"; checked: root.te-lmp; toggled(v) => { root.te-lmp = v; } }
                                                        Check { text: "ID required"; checked: root.te-idreq; toggled(v) => { root.te-idreq = v; } }
                                                        Check { text: "Consent form"; checked: root.te-consent; toggled(v) => { root.te-consent = v; } }
                                                    }
                                                }
                                            }
                                            HorizontalLayout { spacing: 16px;
                                                Field { label: "LabDesk ID"; placeholder: "optional"; text <=> root.te-labid; width: 130px; mono: true; }
                                                VerticalLayout { alignment: end; Check { text: "Only female"; checked: root.te-gender == 1; toggled(v) => { root.te-gender = v ? 1 : 2; } } }
                                                VerticalLayout { alignment: end; Check { text: "Only male"; checked: root.te-gender == 0; toggled(v) => { root.te-gender = v ? 0 : 2; } } }
                                                VerticalLayout { alignment: end; Check { text: "Only billing"; checked: root.te-billing; toggled(v) => { root.te-billing = v; } } }
                                                VerticalLayout { alignment: end; Check { text: "Start from next page"; checked: root.te-nextpage; toggled(v) => { root.te-nextpage = v; } } }
                                                VerticalLayout { alignment: end; Check { text: "Species"; checked: root.te-species; toggled(v) => { root.te-species = v; } } }
                                                Rectangle { horizontal-stretch: 1; }
                                                Seg { label: "Status"; options: ["In use", "Switched off"]; index <=> root.te-state; width: 200px; }
                                            }
                                            HorizontalLayout { spacing: 12px; alignment: start;
                                                VerticalLayout { alignment: center; Check { text: root.te-precol == "" ? "Pre-collection guidelines (none yet)" : "Pre-collection guidelines (added)"; checked: root.te-precol != ""; enabled: false; } }
                                                Btn { text: root.te-precol == "" ? "+  ADD PRE-COLLECTION GUIDELINES" : "EDIT PRE-COLLECTION GUIDELINES"; height: 32px; clicked => { root.te-open-text(2); } }
                                            }
                                        }
                                    }
                                }
                                // copy-from list, shown only while typing in the copy box
                                if root.copy-hits.length > 0 && root.te-copy-q != "": Panel {
                                    VerticalLayout {
                                        Rectangle { height: 34px; Micro { x: 12px; text: "PRESS A TEST TO COPY ITS FIELDS INTO THIS ONE"; vertical-alignment: center; } }
                                        for h[i] in root.copy-hits: ListItem { title: h.name; sub: h.code + "  ·  " + h.dept; side: ""; clicked => { root.te-copy-pick(i); } }
                                    }
                                }
                                HorizontalLayout { spacing: 16px;
                                    // ---- the fields (result lines) of this test ----
                                    Panel {
                                        horizontal-stretch: 1;
                                        VerticalLayout {
                                            Rectangle {
                                                height: 46px;
                                                HorizontalLayout { padding-left: 14px; padding-right: 12px; spacing: 8px;
                                                    VerticalLayout { alignment: center; Micro { text: "FIELDS  ·  what the technician fills in  ·  " + root.frows.length; color: Theme.ink; } }
                                                    Rectangle { horizontal-stretch: 1; }
                                                    VerticalLayout { alignment: center; Btn { text: "DELETE SELECTED"; tone: Theme.red; height: 30px; clicked => { root.rows-delete-selected(); } } }
                                                }
                                            }
                                            Rectangle {
                                                height: 32px; background: Theme.bg; border-width: 1px; border-color: Theme.line;
                                                HorizontalLayout { padding-left: 6px; padding-right: 6px;
                                                    Micro { text: "MOVE"; width: 62px; vertical-alignment: center; font-size: 10px; horizontal-alignment: center; }
                                                    Micro { text: "SELECT"; width: 54px; vertical-alignment: center; font-size: 10px; horizontal-alignment: center; }
                                                    Micro { text: "NAME"; horizontal-stretch: 1; vertical-alignment: center; font-size: 10px; }
                                                    Micro { text: "FIELD"; width: 86px; vertical-alignment: center; font-size: 10px; }
                                                    Micro { text: "UNIT"; width: 70px; vertical-alignment: center; font-size: 10px; }
                                                    Micro { text: "RANGE"; width: 110px; vertical-alignment: center; font-size: 10px; }
                                                    Micro { text: "FORMULA"; width: 66px; vertical-alignment: center; font-size: 10px; horizontal-alignment: center; }
                                                    Micro { text: "DELETE"; width: 62px; vertical-alignment: center; font-size: 10px; horizontal-alignment: center; }
                                                }
                                            }
                                            for r[i] in root.frows: Rectangle {
                                                height: 46px;
                                                background: r.active ? #e7eefc : (rowta.has-hover ? #f7f5f0 : transparent);
                                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                                rowta := TouchArea { clicked => { root.fp-pick(i); } mouse-cursor: pointer; }
                                                HorizontalLayout { padding-left: 6px; padding-right: 6px;
                                                    HorizontalLayout { width: 62px; spacing: 4px; alignment: center;
                                                        Rectangle { width: 24px;
                                                            Path { x: 7px; y: (parent.height - 8px) / 2; width: 10px; height: 7px; viewbox-width: 10; viewbox-height: 7; commands: "M 1 6 L 5 1.5 L 9 6"; stroke: upa.has-hover ? Theme.blue : Theme.muted; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; }
                                                            upa := TouchArea { clicked => { root.row-move(i, -1); } mouse-cursor: pointer; }
                                                        }
                                                        Rectangle { width: 24px;
                                                            Path { x: 7px; y: (parent.height - 8px) / 2; width: 10px; height: 7px; viewbox-width: 10; viewbox-height: 7; commands: "M 1 1 L 5 5.5 L 9 1"; stroke: dna.has-hover ? Theme.blue : Theme.muted; stroke-width: 2px; stroke-line-cap: round; stroke-line-join: round; fill: transparent; }
                                                            dna := TouchArea { clicked => { root.row-move(i, 1); } mouse-cursor: pointer; }
                                                        }
                                                    }
                                                    HorizontalLayout { width: 54px; alignment: center; VerticalLayout { alignment: center; Check { checked: r.selected; toggled(v) => { root.row-select(i, v); } } } }
                                                    Text { text: r.name; horizontal-stretch: 1; font-size: 13px; font-weight: r.title ? 700 : 500; color: r.hidden ? Theme.muted : Theme.ink; vertical-alignment: center; overflow: elide; }
                                                    Text { text: r.field; width: 86px; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                                    Text { text: r.unit; width: 70px; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                                    Text { text: r.range; width: 110px; font-size: 12px; font-family: Theme.mono; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                                    HorizontalLayout { width: 66px; alignment: center; VerticalLayout { alignment: center;
                                                        Rectangle { width: 18px; height: 18px; border-width: 1.5px; border-color: r.formula ? Theme.blue : #b9b5aa; background: r.formula ? Theme.blue : white;
                                                            if r.formula: Tick { x: 2px; y: 2px; width: 14px; height: 14px; } } } }
                                                    HorizontalLayout { width: 62px; alignment: center; VerticalLayout { alignment: center;
                                                        Rectangle { width: 30px; height: 30px; border-width: 1px; border-color: del.has-hover ? Theme.red : #d99; background: del.has-hover ? #fbe9e7 : white;
                                                            Cross { tone: Theme.red; x: 9px; y: 9px; width: 12px; height: 12px; }
                                                            del := TouchArea { clicked => { root.row-delete(i); } mouse-cursor: pointer; } } } }
                                                }
                                            }
                                            if root.frows.length == 0: Rectangle { height: 110px; Text { text: "No fields yet. Fill in the panel on the right and press ADD FIELD."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; } }
                                        }
                                    }
                                    // ---- add / change one field ----
                                    Panel {
                                        width: 350px;
                                        VerticalLayout {
                                            padding: 18px; spacing: 10px; alignment: start;
                                            Micro { text: root.fp-idx >= 0 ? "CHANGE THIS FIELD" : "ADD A FIELD"; color: Theme.blue; }
                                            Pick { text: root.fp-kind == 1 ? "Heading (a title line)" : "Single field"; options: ["Single field", "Heading (a title line)"]; menu-width: 300px; picked(t) => { root.fp-kind = t == "Single field" ? 0 : 1; } }
                                            Field { label: "Name *"; placeholder: "e.g. BILIRUBIN TOTAL"; text <=> root.fp-name; error: root.err-fp-name; edited(_) => { root.err-fp-name = ""; } }
                                            if root.fp-kind == 0: VerticalLayout { spacing: 10px;
                                                HorizontalLayout { spacing: 10px;
                                                    Field { label: "Test method"; placeholder: "optional"; text <=> root.fp-method; }
                                                    Field { label: "Code"; placeholder: "optional"; text <=> root.fp-code; width: 110px; mono: true; }
                                                }
                                                HorizontalLayout { spacing: 10px;
                                                    VerticalLayout { width: 130px; spacing: 4px; Micro { text: "FIELD"; font-size: 10px; } Pick { text: root.fp-field; options: ["Numeric", "Text", "Dropdown", "Multiple ranges"]; menu-width: 190px; picked(t) => { root.fp-field = t; } } }
                                                    HorizontalLayout { spacing: 0px;
                                                        Field { label: "Unit"; placeholder: "e.g. mg/dL"; text <=> root.fp-unit; }
                                                        VerticalLayout { alignment: end; padding-bottom: 1px; Pick { arrow-only: true; width: 28px; clearable: true; options: root.unit-choices; menu-width: 170px; picked(t) => { root.fp-unit = t; } } }
                                                    }
                                                }
                                                if root.fp-field == "Dropdown": Field { label: "Choices (separated by commas)"; placeholder: "Pale yellow, Yellow, Amber"; text <=> root.fp-options; }
                                                if root.fp-field == "Numeric" || root.fp-field == "Multiple ranges": VerticalLayout { spacing: 10px;
                                                    Micro { text: "RESULT RANGE"; font-size: 10px; }
                                                    HorizontalLayout { spacing: 10px;
                                                        Field { placeholder: "From"; text <=> root.fp-from; mono: true; numeric: true; }
                                                        Field { placeholder: "To"; text <=> root.fp-to; mono: true; numeric: true; }
                                                    }
                                                    HorizontalLayout { spacing: 10px;
                                                        Btn { text: "+  ADD AGE RANGE"; height: 32px; clicked => { root.ar-open(true); } }
                                                        Btn { text: "VIEW AGE RANGES"; height: 32px; clicked => { root.ar-open(false); } }
                                                    }
                                                    if root.fp-range-count != "": Text { text: root.fp-range-count; font-size: 12px; color: Theme.blue; wrap: word-wrap; }
                                                    Check { text: "Critical range"; checked: root.fp-crit; toggled(v) => { root.fp-crit = v; } }
                                                    if root.fp-crit: HorizontalLayout { spacing: 10px;
                                                        Field { label: "Less than"; text <=> root.fp-clow; mono: true; numeric: true; }
                                                        Field { label: "More than"; text <=> root.fp-chigh; mono: true; numeric: true; }
                                                    }
                                                }
                                                Field { label: "Result range to show in report"; placeholder: "Leave empty to print the range above"; text <=> root.fp-rtext; }
                                                Field { label: "Formula (calculated from other fields)"; placeholder: "e.g. <Total_Bilirubin> - <Direct_Bilirubin>"; text <=> root.fp-formula; mono: true; }
                                                Check { text: "This parameter is required"; checked: root.fp-required; toggled(v) => { root.fp-required = v; } }
                                                Check { text: "Don't show this parameter in report"; checked: root.fp-hidden; toggled(v) => { root.fp-hidden = v; } }
                                                Check { text: "Omit this from DLC total"; checked: root.fp-omit; toggled(v) => { root.fp-omit = v; } }
                                            }
                                            HorizontalLayout { spacing: 10px; alignment: end;
                                                if root.fp-idx >= 0: Btn { text: "NEW FIELD"; clicked => { root.fp-new(); } }
                                                Btn { text: root.fp-idx >= 0 ? "UPDATE FIELD" : "ADD FIELD"; primary: true; clicked => { root.fp-submit(); } }
                                            }
                                        }
                                    }
                                }
                              }
                            }
                        }

                        // ----- PEOPLE -----
                        if root.s-tab == 3: PageIn {
                            HorizontalLayout {
                                padding: 24px; spacing: 20px;
                                Panel {
                                    width: 400px;
                                    VerticalLayout {
                                        Rectangle {
                                            height: 56px;
                                            Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                            HorizontalLayout {
                                                padding-left: 18px; padding-right: 12px;
                                                VerticalLayout { alignment: center; Micro { text: "PEOPLE WHO CAN SIGN IN"; color: Theme.ink; } }
                                                Rectangle { horizontal-stretch: 1; }
                                                VerticalLayout { alignment: center; Btn { text: "+ ADD PERSON"; primary: true; height: 32px; clicked => { root.ue-new(); } } }
                                            }
                                        }
                                        ScrollView {
                                            vertical-stretch: 1;
                                            VerticalLayout {
                                                for u in root.users: ListItem {
                                                    title: u.name; sub: "@" + u.username + (u.active ? "" : "  ·  SWITCHED OFF"); side: u.role; dim: !u.active; active: root.ue-id == u.id;
                                                    clicked => { root.ue-open(u.id); }
                                                }
                                            }
                                        }
                                    }
                                }
                                Panel {
                                    horizontal-stretch: 1;
                                    if root.ue-id == -1: Rectangle {
                                        VerticalLayout { alignment: center; spacing: 6px;
                                            Text { text: "Give each person their own sign-in"; font-size: 18px; font-weight: 600; color: Theme.ink; horizontal-alignment: center; }
                                            Text { text: "Press + ADD PERSON, or pick someone from the list to change their role or password."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; }
                                        }
                                    }
                                    if root.ue-id != -1: PageIn {
                                        VerticalLayout {
                                            padding: 22px; spacing: 12px; alignment: start;
                                            Micro { text: root.ue-id == 0 ? "NEW PERSON" : "EDIT PERSON"; color: Theme.blue; }
                                            Field { label: "Full name"; placeholder: "e.g. Fozia Shah"; text <=> root.ue-name; error: root.err-ue-name; edited(_) => { root.err-ue-name = ""; } }
                                            Field { label: "Username (used to sign in)"; placeholder: "e.g. fozia"; text <=> root.ue-user; read-only: root.ue-id != 0; error: root.err-ue-user; edited(_) => { root.err-ue-user = ""; } }
                                            Seg { label: "What can this person do?"; options: ["Front desk", "Technician", "Doctor", "Admin"]; locked: [root.ue-lock-demote, root.ue-lock-demote, root.ue-lock-demote, false]; index <=> root.ue-role; }
                                            if root.ue-lock-demote: Text { text: "You are the only Admin, so you cannot change your own role or switch yourself off. First make another person an Admin, then you can change this."; font-size: 12px; color: Theme.ink; font-weight: 600; wrap: word-wrap; }
                                            if !root.ue-lock-demote: Text { text: root.ue-role == 0 ? "Registers patients, takes payments and hands over reports." : root.ue-role == 1 ? "Enters test results." : root.ue-role == 2 ? "Enters results, approves reports and corrects them." : "Can do everything, including settings and people."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                            if !root.ue-target-admin: Field { label: root.ue-id == 0 ? "Password" : "New password (leave empty to keep the old one)"; text <=> root.ue-pass; password: true; error: root.err-ue-pass; edited(_) => { root.err-ue-pass = ""; } }
                                            if root.ue-target-admin && root.ue-id != 0: Text { text: "An Admin's password can only be changed by that Admin, from My account, by typing the current password."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                            if root.ue-id != 0: Seg { label: "Account"; options: ["Can sign in", "Switched off"]; locked: [false, root.ue-lock-demote]; index <=> root.ue-state; }
                                            Rectangle { height: 4px; }
                                            HorizontalLayout { spacing: 10px;
                                                Btn { text: root.ue-id == 0 ? "CREATE ACCOUNT" : "SAVE CHANGES"; primary: true; clicked => { root.ue-save(); } }
                                                if root.ue-can-remove: Btn { text: "REMOVE THIS PERSON"; clicked => { root.ue-remove(); } }
                                                Rectangle { horizontal-stretch: 1; }
                                            }
                                            Text { text: "Tell the person their username and password. They can change the password themselves under My account."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                        }
                                    }
                                }
                            }
                        }

                        // ----- DATA -----
                        if root.s-tab == 4: PageIn { ScrollView { VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "BACKUP"; color: Theme.green; }
                                Text { text: "Keep a safe copy of all your data"; font-size: 16px; font-weight: 700; color: Theme.ink; }
                                Text { text: "LabDesk makes a backup by itself once a day while it is open. You can also press BACK UP NOW at any time. Choose a folder on another drive or a USB drive, because a backup on the same disk is lost if that disk fails."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                HorizontalLayout { spacing: 10px;
                                    Field { label: "Backup folder"; text <=> root.bk-folder; read-only: true; mono: true; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: end; Btn { text: "CHOOSE…"; clicked => { root.choose-backup-folder(); } } }
                                }
                                HorizontalLayout { spacing: 10px;
                                    Field { label: "Cloud copy (Google Drive, OneDrive, Dropbox…)"; placeholder: "Not set"; text <=> root.bk-cloud; read-only: true; mono: true; horizontal-stretch: 1; }
                                    VerticalLayout { alignment: end; Btn { text: "CHOOSE…"; clicked => { root.choose-cloud-folder(); } } }
                                    if root.bk-cloud != "": VerticalLayout { alignment: end; Btn { text: "CLEAR"; tone: Theme.red; clicked => { root.clear-cloud-folder(); } } }
                                }
                                Text { text: "How to back up to the cloud: install Google Drive for desktop (or OneDrive / Dropbox) on this computer, then choose a folder inside it as the cloud copy. Every backup is also copied there and the cloud app uploads it for you. LabDesk never asks for your Google password."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                Seg { label: "Protect backups"; options: ["Not locked", "Locked with a password"]; index <=> root.bk-encrypt; }
                                if root.bk-encrypt == 1: VerticalLayout { spacing: 8px;
                                    Field { label: "Backup password"; text <=> root.bk-password; password: true; error: root.err-bk-password; edited(_) => { root.err-bk-password = ""; } }
                                    Text { text: "A locked backup is safe even if someone gets the file from your cloud. But nobody can open it without this password, not even the LabDesk developer. Write the password on paper and keep it safe."; font-size: 12px; color: Theme.ink; font-weight: 600; wrap: word-wrap; }
                                }
                                Text { text: root.bk-last; font-size: 13px; font-weight: 600; color: Theme.ink; wrap: word-wrap; }
                                HorizontalLayout { spacing: 10px;
                                    Btn { text: "SAVE BACKUP SETTINGS"; clicked => { root.save-backup-settings(); } }
                                    Btn { text: "BACK UP NOW"; primary: true; tone: Theme.green; clicked => { root.backup-now(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "USE A BACKUP LATER"; color: Theme.amber; }
                                Text { text: "Restore your data from a backup"; font-size: 16px; font-weight: 700; color: Theme.ink; }
                                Text { text: "Use this if the computer was changed or damaged, or if something was lost. Choose a backup file (labdesk-backup-….db or .ldbk). LabDesk checks the file, saves a safety copy of today's data, and then replaces everything with the backup. Afterwards you sign in with the people and passwords that the backup had.\n\nOn a brand-new computer: install LabDesk, and on the first screen press \"Restore from a backup\"."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                HorizontalLayout { Btn { text: "RESTORE FROM A BACKUP…"; tone: Theme.red; clicked => { root.restore-backup(); } } Rectangle { horizontal-stretch: 1; } }
                            }
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "DELETED REPORTS"; color: Theme.pink; }
                                Text { text: "Reports that were deleted can be brought back from here."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                for d in root.deleted: Rectangle {
                                    height: 58px;
                                    Rectangle { y: 0px; height: 1px; background: Theme.line; }
                                    HorizontalLayout { spacing: 12px; padding-top: 6px;
                                        VerticalLayout { alignment: center; horizontal-stretch: 1;
                                            Text { text: d.name + "  ·  " + d.code; font-size: 14px; font-weight: 600; color: Theme.ink; overflow: elide; }
                                            Text { text: d.note; font-size: 11px; color: Theme.muted; overflow: elide; }
                                        }
                                        VerticalLayout { alignment: center; Btn { text: "RESTORE"; height: 30px; clicked => { root.restore-deleted(d.id); } } }
                                    }
                                }
                                if root.deleted.length == 0: Text { text: "No deleted reports."; font-size: 13px; color: Theme.ink; }
                            }
                        } } }

                        // ----- MY ACCOUNT -----
                        if root.s-tab == 5: PageIn { ScrollView { HorizontalLayout { padding: 24px; spacing: 20px; alignment: start;
                            Panel {
                                width: 440px; height: 430px;
                                VerticalLayout {
                                    padding: 22px; spacing: 12px; alignment: start;
                                    Micro { text: "MY ACCOUNT"; color: Theme.blue; }
                                    Text { text: root.user-name; font-size: 20px; font-weight: 700; color: Theme.ink; }
                                    Text { text: "Signed in as " + root.user-role; font-size: 12px; color: Theme.muted; }
                                    Rectangle { height: 6px; }
                                    Field { label: "Current password"; text <=> root.ma-old; password: true; error: root.err-ma-old; edited(_) => { root.err-ma-old = ""; } }
                                    Field { label: "New password"; text <=> root.ma-new; password: true; error: root.err-ma-new; edited(_) => { root.err-ma-new = ""; } }
                                    Field { label: "New password again"; text <=> root.ma-new2; password: true; accepted => { root.change-my-password(); } }
                                    Rectangle { height: 4px; }
                                    Btn { text: "CHANGE PASSWORD"; primary: true; clicked => { root.change-my-password(); } }
                                }
                            }
                            if root.is-admin: Panel {
                                width: 400px; height: 300px;
                                VerticalLayout {
                                    padding: 22px; spacing: 12px; alignment: start;
                                    Micro { text: "IF YOU FORGET YOUR PASSWORD"; color: Theme.pink; }
                                    Text { text: root.has-recovery ? "A recovery code was made for this lab." : "No recovery code yet."; font-size: 15px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                                    Text { text: "With the recovery code an Admin can choose a new password from the sign-in screen (\"Forgot your password?\"). Keep the code somewhere safe, away from this computer, for example written on paper or on a USB drive.\n\nMaking a new code stops the old one from working."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    Btn { text: "MAKE A NEW RECOVERY CODE"; clicked => { root.new-recovery-code(); } }
                                }
                            }
                        } } }

                        // ----- HELP -----
                        if root.s-tab == 6: PageIn { ScrollView { VerticalLayout { padding: 24px; spacing: 16px; alignment: start;
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "HELP"; color: Theme.blue; }
                                Text { text: "What do you want to do?"; font-size: 18px; font-weight: 700; color: Theme.ink; }
                                Field { placeholder: "Type a word, for example: delete, backup, password, bill, doctor"; text <=> root.help-query; edited(t) => { root.help-edited(t); } }
                            }
                            for h in root.help-items: Rectangle {
                                max-width: 760px; background: Theme.paper; border-width: 1px; border-color: Theme.line;
                                height: hl.preferred-height;
                                hl := VerticalLayout { padding: 18px; spacing: 6px;
                                    Text { text: h.title; font-size: 15px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                                    Text { text: h.body; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                                }
                            }
                            if root.help-items.length == 0: Text { text: "Nothing matches that. Try one simple word, or send us a problem report below."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "SOMETHING NOT WORKING?"; color: Theme.pink; }
                                Text { text: "If LabDesk closed by itself or showed a strange message, press the button. It saves a small text file with technical details (version, what went wrong, recent actions). It does not contain patient names or results. Send that file to your software provider."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                HorizontalLayout { Btn { text: "SAVE A PROBLEM REPORT"; clicked => { root.make-problem-report(); } } Rectangle { horizontal-stretch: 1; } }
                            }
                        } } }
                        if root.s-tab == 9: PageIn { ScrollView { VerticalLayout { padding: 24px; spacing: 20px; alignment: start;
                            AutoPanel {
                                max-width: 760px;
                                Micro { text: "EMAIL"; color: Theme.blue; }
                                Text { text: "Send reports by email"; font-size: 16px; font-weight: 700; color: Theme.ink; }
                                Text { text: "When this is on, an EMAIL button appears next to WHATSAPP on every report. It sends the report PDF, already attached, from your lab's own email account to the patient's email address. It is OFF until you turn it on here."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                Seg { label: "Email"; options: ["Off", "On"]; index <=> root.em-on; }
                                Seg { label: "Which email service does the lab use?"; options: ["Proton Mail", "Gmail", "Outlook", "Other"]; index <=> root.em-provider; }
                                if root.em-provider == 0: Text { text: "Proton Mail is the most private choice. Sending from another program needs a PAID Proton plan with an address on your own domain (for example reports@yourlab.in). In Proton: Settings > IMAP/SMTP > SMTP tokens > Generate token. Use that token below as the password. The token is shown only once. Mail sent this way is not end-to-end encrypted."; font-size: 12px; color: Theme.ink; wrap: word-wrap; }
                                if root.em-provider == 1: Text { text: "Gmail needs 2-Step Verification turned on, then an App Password: Google Account > Security > 2-Step Verification > App passwords. Use that 16-letter App Password below, not your normal password."; font-size: 12px; color: Theme.ink; wrap: word-wrap; }
                                if root.em-provider == 2: Text { text: "Outlook needs an App Password from your Microsoft account security page. Some Microsoft accounts no longer allow other programs to send mail. If it is refused, use Proton or another service."; font-size: 12px; color: Theme.ink; wrap: word-wrap; }
                                if root.em-provider == 3: Text { text: "Ask your email provider (or the person who set up your lab's email) for the SMTP server name and port. Port 587 is the usual one; 465 also works."; font-size: 12px; color: Theme.ink; wrap: word-wrap; }
                                if root.em-provider == 3: HorizontalLayout { spacing: 10px;
                                    Field { label: "Mail server (SMTP)"; placeholder: "smtp.example.com"; text <=> root.em-host; mono: true; horizontal-stretch: 1; }
                                    Field { label: "Port"; text <=> root.em-port; mono: true; width: 110px; }
                                }
                                Field { label: "Your email address (user name)"; placeholder: "reports@yourlab.in"; text <=> root.em-user; error: root.err-em; edited(_) => { root.err-em = ""; } }
                                Field { label: root.em-provider == 0 ? "SMTP token" : "App password"; text <=> root.em-pass; password: true; }
                                Field { label: "Name patients see (leave empty to use the lab name)"; text <=> root.em-name; }
                                Rectangle {
                                    background: Theme.amber.with-alpha(0.14); border-width: 1px; border-color: Theme.amber;
                                    VerticalLayout { padding: 12px; spacing: 6px;
                                        Text { text: "Please read"; font-size: 12px; font-weight: 700; color: Theme.ink; }
                                        Text { text: "An emailed report travels through your email provider's servers (and the patient's). That is less private than printing or WhatsApp Web on this PC. Only send reports to the address the patient gave you.\n\nThe app password is saved on this computer so reports can be sent. It is NOT included in backups. The password is hidden on screen, and only an Admin can open this page."; font-size: 12px; color: Theme.ink; wrap: word-wrap; }
                                    }
                                }
                                HorizontalLayout { spacing: 10px;
                                    Btn { text: "SAVE EMAIL SETTINGS"; primary: true; tone: Theme.blue; clicked => { root.em-save(); } }
                                    Btn { text: root.em-busy ? "SENDING…" : "SEND A TEST EMAIL TO MYSELF"; enabled: !root.em-busy; clicked => { root.em-test(); } }
                                    Rectangle { horizontal-stretch: 1; }
                                }
                            }
                        } } }
                        if root.s-tab == 8: PageIn { ScrollView { HorizontalLayout { padding: 28px; spacing: 24px; alignment: start;
                            Panel {
                                width: 520px; height: 450px;
                                VerticalLayout {
                                    padding: 26px; spacing: 12px; alignment: start;
                                    Micro { text: "BLOOD CELL COUNTER (ANALYZER)"; color: Theme.pink; }
                                    Text { text: "Results from the analyzer arrive by themselves and wait in the ANALYZER tab. You attach each one to the right report. The doctor still checks and approves; nothing is approved automatically."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                                    Field { label: "Port (the same number as on the machine)"; text <=> root.mc-port; mono: true; error: root.err-mc; read-only: root.mc-auto || root.mc-running; edited(_) => { root.err-mc = ""; } }
                                    HorizontalLayout { spacing: 8px; alignment: start;
                                        Btn { text: root.mc-auto ? "TURN OFF RECEIVING" : "TURN ON RECEIVING"; primary: true; tone: root.mc-auto ? Theme.red : Theme.green; clicked => { root.mc-auto-toggle(); } }
                                        Btn { text: "OPEN ANALYZER RESULTS"; clicked => { root.navigate(8); } }
                                    }
                                    Rectangle { height: 40px; background: root.mc-auto ? #1f7a4a14 : Theme.bg; border-width: 1px; border-color: root.mc-auto ? Theme.green : Theme.line;
                                        Text { x: 10px; width: parent.width - 20px; text: root.mc-auto-status; font-size: 12px; color: Theme.ink; vertical-alignment: center; overflow: elide; } }
                                    Micro { text: "NORMAL RANGES AND H / L MARKS ON REPORTS"; color: Theme.blue; }
                                    Seg { options: ["Same as the analyzer", "LabDesk's own"]; locked: [false, false]; index <=> root.mc-range; changed index => { root.mc-range-set(self.index); } }
                                    Text { text: "Same as the analyzer: the ranges and marks are exactly what the analyzer's own print shows. LabDesk's own: ranges by age and gender from your test settings."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    Text { text: "Close the analyzer's own computer software first: only one program can use the port at a time."; font-size: 12px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                                }
                            }
                        } } }
                        if root.s-tab == 7: PageIn { ScrollView { HorizontalLayout { padding: 28px; spacing: 24px; alignment: start;
                            Panel {
                                width: 520px; height: 830px;
                                VerticalLayout {
                                    padding: 28px; spacing: 10px; alignment: start;
                                    HorizontalLayout { spacing: 14px; alignment: start;
                                        Image { source: @image-url("../assets/logo-112.png"); width: 54px; height: 54px; }
                                        VerticalLayout { alignment: center; spacing: 2px;
                                            Text { text: "LABDESK"; font-family: Theme.mono; font-size: 26px; font-weight: 800; letter-spacing: 4px; color: Theme.ink; }
                                            Micro { text: "VERSION " + root.app-version; }
                                        }
                                    }
                                    Rectangle { height: 6px; }
                                    Text { text: "Simple software for a pathology lab: register patients, enter results, print bills and reports. It works without internet and keeps your data on this computer."; font-size: 14px; color: Theme.ink; wrap: word-wrap; }
                                    Rectangle { height: 4px; }
                                    Micro { text: "MADE BY"; color: Theme.blue; }
                                    Text { text: "Syed Mutaib"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                                    Text { text: "From Kashmir. Designed and written for real labs."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                                    Rectangle { height: 4px; }
                                    Micro { text: "OPEN SOURCE"; color: Theme.green; }
                                    Text { text: "LabDesk is free, open-source software under the GNU General Public License v3. The source code is on GitHub, under the profile @mstudio005."; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                                    HorizontalLayout { spacing: 10px; alignment: start;
                                        Btn { text: "GITHUB  @mstudio005"; primary: true; clicked => { root.open-github(); } }
                                        Btn { text: "OPEN DATA FOLDER"; clicked => { root.open-data-folder(); } }
                                    }
                                    Rectangle { height: 4px; }
                                    Micro { text: "WHERE YOUR DATA LIVES"; }
                                    Text { text: root.about-path; font-family: Theme.mono; font-size: 11px; color: Theme.muted; wrap: word-wrap; }
                                    Text { text: "Your data is kept in one SQLite file on this computer. Every change is recorded in a log that cannot be edited."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                    Rectangle { height: 4px; }
                                    Micro { text: "UPDATES"; color: Theme.green; }
                                    Text { text: root.upd-status; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                                    HorizontalLayout { spacing: 10px; alignment: start;
                                        Btn { text: root.upd-busy ? "CHECKING…" : "CHECK FOR UPDATES"; enabled: !root.upd-busy; clicked => { root.upd-check(); } }
                                        if root.upd-ready: Btn { text: "INSTALL NOW"; primary: true; tone: Theme.green; clicked => { root.upd-install(); } }
                                    }
                                    Check { text: "Check for updates automatically"; checked: root.upd-auto; toggled(v) => { root.upd-auto-set(v); } }
                                    Text { text: "Only the version number is asked for. A new version is downloaded quietly, checked, and installed the next time LabDesk starts. Your data is backed up first and is never changed by an update."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                }
                            }
                            Panel {
                                width: 360px; height: 300px;
                                VerticalLayout {
                                    padding: 28px; spacing: 14px; alignment: start;
                                    Micro { text: "HOW LABDESK IS BUILT"; color: Theme.pink; }
                                    Text { text: "Slint is a frontend programming language used in this software for the screens you see and click. Rust is used for everything else: patients, results, reports, backups and your data."; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                                    Rectangle { height: 6px; }
                                    Micro { text: "MADE WITH"; }
                                    Text { text: "Screens: Slint (slint.dev)\nEverything else: Rust and SQLite"; font-family: Theme.mono; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                                }
                            }
                        } } }
                    }
                }
            }

            // ===== RESULT SHEET =====
            if root.page == 4: PageIn {
                VerticalLayout {
                    padding: 24px; spacing: 14px;
                    if root.verdict-kind != 0: VerdictBar { kind: root.verdict-kind; text: root.verdict-text; can-open: false; dismiss => { root.verdict-dismiss(); } }
                    Panel {
                        height: 84px;
                        HorizontalLayout {
                            padding: 16px; spacing: 14px;
                            Rectangle {
                                width: 36px; height: 36px; y: (parent.height - self.height) / 2; background: bt.has-hover ? Theme.hover : transparent; border-width: 1px; border-color: Theme.line;
                                animate background { duration: Theme.quick; }
                                Text { text: "‹"; font-size: 24px; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
                                bt := TouchArea { clicked => { root.navigate(2); } mouse-cursor: pointer; }
                            }
                            VerticalLayout {
                                alignment: center; spacing: 4px;
                                Text { text: root.r-title; font-size: 21px; font-weight: 700; color: Theme.ink; }
                                Micro { text: root.r-sub; }
                            }
                            Rectangle { horizontal-stretch: 1; }
                            HorizontalLayout { spacing: 8px; alignment: end;
                                if root.r-can-edit: VerticalLayout { alignment: center; Btn { text: "EDIT PATIENT"; height: 30px; clicked => { root.edit-patient(); } } }
                                if root.r-can-delete: VerticalLayout { alignment: center; Btn { text: "DELETE"; tone: Theme.red; height: 30px; clicked => { root.delete-report(); } } }
                            }
                            VerticalLayout { alignment: center; spacing: 6px; StatusChip { status: root.r-status; x: parent.width - self.width; } Micro { text: root.r-money; horizontal-alignment: right; } }
                        }
                    }
                    HorizontalLayout {
                        spacing: 8px; height: 36px;
                        Btn { text: "SAVE"; enabled: root.r-can-save; clicked => { root.save-draft(); } }
                        Btn { text: "APPROVE"; primary: true; tone: Theme.green; enabled: root.r-can-approve; clicked => { root.approve(); } }
                        Btn { text: "CORRECT"; tone: Theme.amber; enabled: root.r-can-correct; clicked => { root.ask-correction(); } }
                        Btn { text: "MARK DELIVERED"; primary: true; tone: Theme.blue; enabled: root.r-can-deliver; clicked => { root.deliver(); } }
                        Rectangle { horizontal-stretch: 1; }
                        if root.r-asking-reason: HorizontalLayout {
                            spacing: 8px;
                            Rectangle {
                                width: 340px; border-width: 2px; border-color: Theme.amber; background: Theme.paper;
                                HorizontalLayout { padding-left: 10px; padding-right: 10px;
                                    rq := TextInput { text <=> root.r-reason; font-size: 14px; color: Theme.ink; vertical-alignment: center; }
                                }
                                if rq.text == "": Text { x: 10px; text: "Why is it being corrected? (min. 5 letters)"; color: #a9a59b; font-size: 14px; vertical-alignment: center; }
                            }
                            Btn { text: "CONFIRM"; primary: true; tone: Theme.amber; clicked => { root.confirm-correction(); } }
                            Btn { text: "CANCEL"; clicked => { root.cancel-correction(); } }
                        }
                    }
                    if !root.r-asking-reason: HorizontalLayout {
                        spacing: 8px; height: 36px;
                        Btn { text: root.use-letterhead ? "LETTERHEAD: ON" : "LETTERHEAD: OFF"; tone: Theme.muted; clicked => { root.use-letterhead = !root.use-letterhead; } }
                        Btn { text: root.bill-header ? "BILL HEADER: ON" : "BILL HEADER: OFF"; tone: Theme.muted; enabled: root.r-can-bill; clicked => { root.bill-header = !root.bill-header; root.bill-prefs-save(); } }
                        Btn { text: root.bill-paper == 0 ? "BILL: NORMAL (A4)" : (root.bill-paper == 1 ? "BILL: THERMAL 80 MM" : "BILL: THERMAL 58 MM"); tone: Theme.muted; enabled: root.r-can-bill; clicked => { root.bill-paper = root.bill-paper == 2 ? 0 : root.bill-paper + 1; root.bill-prefs-save(); } }
                        if root.r-can-pay: Btn { text: "RECEIVE PAYMENT"; primary: true; tone: Theme.green; clicked => { root.pay-open(); } }
                        Btn { text: "PRINT BILL"; tone: Theme.blue; enabled: root.r-can-bill; clicked => { root.print-bill(); } }
                        Btn { text: "BILL PDF"; primary: true; tone: Theme.blue; enabled: root.r-can-bill; clicked => { root.make-bill(); } }
                        Rectangle { horizontal-stretch: 1; }
                        Btn { text: "EMAIL"; tone: Theme.blue; enabled: root.r-can-print; clicked => { root.share-email(); } }
                        Btn { text: "WHATSAPP"; tone: Theme.green; enabled: root.r-can-print; clicked => { root.share-whatsapp(); } }
                        Btn { text: "PRINT REPORT"; tone: Theme.pink; enabled: root.r-can-print; clicked => { root.print-report(); } }
                        Btn { text: "REPORT PDF"; primary: true; tone: Theme.pink; enabled: root.r-can-print; clicked => { root.make-report(); } }
                    }
                    if root.r-lock-note != "": Text { text: root.r-lock-note; font-size: 12px; color: Theme.muted; }
                    if root.r-pay-text != "": Text { text: root.r-pay-text; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    Panel {
                        vertical-stretch: 1; clip: true;
                        VerticalLayout {
                            Rectangle {
                                height: 34px;
                                Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                HorizontalLayout {
                                    padding-left: 16px; padding-right: 16px; spacing: 12px;
                                    Micro { text: "TEST"; horizontal-stretch: 1; vertical-alignment: center; }
                                    Micro { text: "RESULT"; width: 160px; vertical-alignment: center; }
                                    Micro { text: "UNIT"; width: 90px; vertical-alignment: center; }
                                    Micro { text: "NORMAL RANGE"; width: 200px; vertical-alignment: center; }
                                    Micro { text: ""; width: 54px; vertical-alignment: center; }
                                }
                            }
                            ScrollView {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    for p[i] in root.params: Rectangle {
                                        height: p.kind == 2 ? 40px : 44px;
                                        background: p.kind == 2 ? Theme.bg : transparent;
                                        Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                        if p.kind == 2: HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                                            Text { text: p.name; font-size: 14px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                                            Rectangle { horizontal-stretch: 1; }
                                            Rectangle { width: 90px; StatusChip { status: p.status; x: parent.width - self.width; } }
                                        }
                                        if p.kind == 1: Text { x: 16px; text: p.name; font-size: 13px; font-weight: 700; color: Theme.muted; vertical-alignment: center; }
                                        if p.kind == 0: HorizontalLayout {
                                            padding-left: 16px; padding-right: 16px; spacing: 12px;
                                            Text { text: p.name + (p.formula ? "   (calculated)" : ""); horizontal-stretch: 1; font-size: 14px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                            Rectangle {
                                                width: 160px; y: 6px; height: 32px;
                                                if p.choice: Pick {
                                                    x: 0px; width: 160px;
                                                    text: p.value; options: root.choices; enabled: !p.locked; clearable: true; placeholder: "Choose…"; menu-width: 220px;
                                                    opened => { root.prepare-choices(i); }
                                                    picked(t) => { root.value-edited(i, t); }
                                                }
                                                if !p.choice: Rectangle {
                                                    border-width: p.locked ? 0px : 1px;
                                                    border-color: p.locked ? transparent : (cell.has-focus ? Theme.ink : Theme.line);
                                                    background: p.locked ? transparent : (p.formula ? Theme.bg : white);
                                                    animate border-color { duration: Theme.quick; }
                                                    HorizontalLayout {
                                                        padding-left: 8px; padding-right: 8px;
                                                        cell := TextInput {
                                                            text: p.value; read-only: p.locked || p.formula;
                                                            font-family: Theme.mono; font-size: 14px; vertical-alignment: center;
                                                            color: p.flag == "Critical" ? Theme.red : p.flag != "" ? Theme.amber : Theme.ink;
                                                            font-weight: p.flag != "" ? 700 : 400;
                                                            edited => { root.value-edited(i, self.text); }
                                                        }
                                                    }
                                                }
                                            }
                                            Text { text: p.unit; width: 90px; font-size: 13px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                            Text { text: p.range; width: 200px; font-family: Theme.mono; font-size: 12px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                            Rectangle { width: 54px; FlagChip { flag: p.flag; y: (parent.height - self.height) / 2; } }
                                        }
                                    }
                                    if root.params.length == 0: Rectangle {
                                        height: 140px;
                                        Text { text: "Pick a report from the Reports list to enter results."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                }
            }
        }

        // ---------- footer ----------
        Rectangle {
            height: 30px; background: Theme.paper;
            Rectangle { y: 0px; height: 1px; background: Theme.line; }
            HorizontalLayout {
                padding-left: 20px; padding-right: 20px; spacing: 8px;
                Rectangle { width: 8px; height: 8px; y: (parent.height - self.height) / 2; border-radius: 4px; background: Theme.green; }
                Micro { text: "WORKS OFFLINE  ·  DATA STAYS ON THIS COMPUTER"; vertical-alignment: center; }
                Rectangle { horizontal-stretch: 1; }
                Micro { text: "LABDESK"; vertical-alignment: center; }
            }
        }
    }

    // ---------- sign-in / first-time setup (covers everything until someone signs in) ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.veil > 0.01;
        opacity: root.veil;
        background: Theme.bg;
        TouchArea { }
        // soft colour band behind the card
        Rectangle { y: 0px; height: 6px; background: Theme.ink; }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 460px;
                    height: card.preferred-height;
                    y: (1 - root.veil) * -24px;
                    background: Theme.paper; border-width: 1px; border-color: Theme.line;
                    drop-shadow-blur: 30px; drop-shadow-color: #14130f1c; drop-shadow-offset-y: 10px;
                    card := VerticalLayout {
                        padding: 36px; padding-top: 32px; padding-bottom: 30px; spacing: 12px;
                        HorizontalLayout { alignment: center; spacing: 12px;
                            Image { source: @image-url("../assets/logo-96.png"); width: 46px; height: 46px; }
                            VerticalLayout { alignment: center; Text { text: "LABDESK"; font-family: Theme.mono; font-size: 24px; font-weight: 800; letter-spacing: 4px; color: Theme.ink; } }
                        }
                        Rectangle { height: 6px; }
                        Text { text: root.auth-first-run ? "Welcome! Let's set up your lab" : root.auth-forgot ? "Forgot your password?" : "Welcome back"; font-size: 22px; font-weight: 700; color: Theme.ink; horizontal-alignment: center; }
                        Text { text: root.auth-first-run ? "Create the Admin account. You will use it to add your team and set up reports." : root.auth-forgot ? "No problem. You can choose a new one." : "Please sign in to continue."; font-size: 13px; color: Theme.muted; horizontal-alignment: center; wrap: word-wrap; }
                        Rectangle { height: 4px; }
                        if !root.auth-first-run && !root.auth-forgot: VerticalLayout {
                            spacing: 12px;
                            Field { label: "Username"; text <=> root.l-user; error: root.err-login != "" ? " " : ""; edited(_) => { root.err-login = ""; } accepted => { root.sign-in(); } }
                            Field { label: "Password"; text <=> root.l-pass; password: true; error: root.err-login; edited(_) => { root.err-login = ""; } accepted => { root.sign-in(); } }
                            Rectangle { height: 2px; }
                            Rectangle {
                                height: 24px;
                                HorizontalLayout { spacing: 10px; alignment: start;
                                    Rectangle {
                                        width: 20px; height: 20px; y: (parent.height - self.height) / 2;
                                        border-width: 2px; border-color: Theme.ink; background: root.l-keep ? Theme.ink : transparent;
                                        animate background { duration: Theme.quick; }
                                        if root.l-keep: Tick { x: 3px; y: 3px; width: 12px; height: 12px; }
                                    }
                                    Text { text: "Keep me signed in on this computer"; font-size: 13px; color: Theme.ink; vertical-alignment: center; }
                                }
                                TouchArea { clicked => { root.l-keep = !root.l-keep; } mouse-cursor: pointer; }
                            }
                            Btn { text: "SIGN IN"; primary: true; height: 44px; clicked => { root.sign-in(); } }
                            Text { text: "Forgot your password?"; font-size: 13px; color: Theme.blue; horizontal-alignment: center; TouchArea { clicked => { root.forgot-open(); } mouse-cursor: pointer; } }
                        }
                        if root.auth-first-run: VerticalLayout {
                            spacing: 12px;
                            Field { label: "Your name"; placeholder: "e.g. Syed Mutaib"; text <=> root.a-name; error: root.err-a-name; edited(_) => { root.err-a-name = ""; } }
                            Field { label: "Choose a username"; placeholder: "e.g. mutaib"; text <=> root.a-user; error: root.err-a-user; edited(_) => { root.err-a-user = ""; } }
                            Field { label: "Choose a password"; text <=> root.a-pass; password: true; error: root.err-a-pass; edited(_) => { root.err-a-pass = ""; } }
                            Field { label: "Type the password again"; text <=> root.a-pass2; password: true; error: root.err-a-pass2; edited(_) => { root.err-a-pass2 = ""; } accepted => { root.create-first-admin(); } }
                            Rectangle { height: 4px; }
                            Btn { text: "CREATE ACCOUNT AND START"; primary: true; height: 44px; clicked => { root.create-first-admin(); } }
                            Text { text: "Already used LabDesk before? Restore from a backup"; font-size: 13px; color: Theme.blue; horizontal-alignment: center; TouchArea { clicked => { root.restore-first-run(); } mouse-cursor: pointer; } }
                        }
                        if root.auth-forgot: VerticalLayout {
                            spacing: 12px;
                            Text { text: "Doctors, technicians and front desk: please ask your Admin to set a new password for you (Settings > People & passwords).\n\nAdmins: type your username, the recovery code you saved when LabDesk was set up, and choose a new password. Forgot the username too? Type only the recovery code and press SHOW MY USERNAME."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                            Field { label: "Admin username"; text <=> root.f-user; error: root.err-f-user; edited(_) => { root.err-f-user = ""; } }
                            Field { label: "Recovery code"; placeholder: "XXXXX-XXXXX-XXXXX-XXXXX"; mono: true; text <=> root.f-code; error: root.err-f-code; edited(_) => { root.err-f-code = ""; } }
                            HorizontalLayout { spacing: 10px; alignment: start;
                                Btn { text: "SHOW MY USERNAME"; height: 32px; clicked => { root.find-username(); } }
                                if root.f-found != "": Text { text: root.f-found; font-family: Theme.mono; font-size: 13px; font-weight: 700; color: Theme.green; vertical-alignment: center; wrap: word-wrap; horizontal-stretch: 1; }
                            }
                            Field { label: "New password"; text <=> root.f-pass; password: true; error: root.err-f-pass; edited(_) => { root.err-f-pass = ""; } }
                            Field { label: "New password again"; text <=> root.f-pass2; password: true; error: root.err-f-pass2; edited(_) => { root.err-f-pass2 = ""; } accepted => { root.recover(); } }
                            Rectangle { height: 4px; }
                            Btn { text: "SET NEW PASSWORD"; primary: true; height: 44px; clicked => { root.recover(); } }
                            Text { text: "Back to sign in"; font-size: 13px; color: Theme.blue; horizontal-alignment: center; TouchArea { clicked => { root.forgot-back(); } mouse-cursor: pointer; } }
                        }
                        Rectangle { height: 2px; }
                        Text { text: "Works offline. Your data stays on this computer."; font-size: 11px; color: Theme.muted; horizontal-alignment: center; }
                    }
                }
            }
        }
    }

    // ---------- correct a patient's details ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.eveil > 0.01; opacity: root.eveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: 560px; height: min(root.height - 40px, 700px); y: (1 - root.eveil) * 18px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.blue; }
                VerticalLayout {
                    padding: 26px; padding-top: 30px; spacing: 10px;
                    Text { text: "Correct patient details"; font-size: 21px; font-weight: 700; color: Theme.ink; }
                    if root.e-note != "": Text { text: root.e-note; font-size: 12px; color: Theme.ink; font-weight: 600; wrap: word-wrap; }
                    ScrollView {
                        vertical-stretch: 1;
                        VerticalLayout { padding-right: 14px; padding-bottom: 8px;
                            PatientForm {
                                first <=> root.e-first; last <=> root.e-last; age <=> root.e-age; age-type <=> root.e-age-type; gender <=> root.e-gender;
                                phone <=> root.e-phone; email <=> root.e-email; address <=> root.e-address; ref-mode <=> root.e-ref; doctor <=> root.e-doctor;
                                err-first <=> root.err-e-first; err-age <=> root.err-e-age; err-address <=> root.err-e-address; err-email <=> root.err-e-email; err-doctor <=> root.err-e-doctor;
                                lock-name: root.e-lock-name; lock-body: root.e-lock-body; lock-ref: root.e-lock-ref;
                                suggestions: root.doctor-suggestions;
                                doctor-edited(t) => { root.e-doctor-edited(t); }
                            }
                        }
                    }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "CANCEL"; clicked => { root.edit-cancel(); } }
                        Btn { text: "SAVE CHANGES"; primary: true; clicked => { root.edit-save(); } }
                    }
                }
            }
        } }
    }

    // ---------- summary of a range of days, and export to Excel ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.smveil > 0.01; opacity: root.smveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: 700px; height: min(smcard.preferred-height, root.height - 40px); y: (1 - root.smveil) * 18px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.blue; }
                smcard := VerticalLayout {
                    padding: 26px; padding-top: 30px; spacing: 10px;
                    Text { text: "Summary and export"; font-size: 21px; font-weight: 700; color: Theme.ink; }
                    HorizontalLayout { spacing: 10px;
                        Field { label: "From"; text <=> root.sm-from; mono: true; error: root.err-sm; edited(_) => { root.err-sm = ""; } }
                        Field { label: "To (year-month-day)"; text <=> root.sm-to; mono: true; edited(_) => { root.err-sm = ""; } }
                    }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Btn { text: "TODAY"; height: 30px; clicked => { root.sm-range(0); } }
                        Btn { text: "LAST 7 DAYS"; height: 30px; clicked => { root.sm-range(1); } }
                        Btn { text: "THIS MONTH"; height: 30px; clicked => { root.sm-range(2); } }
                        Btn { text: "SHOW"; primary: true; tone: Theme.blue; height: 30px; clicked => { root.sm-run(); } }
                    }
                    ScrollView { height: 310px;
                        VerticalLayout { alignment: start;
                            for r in root.sm-rows: Rectangle {
                                height: r.kind == 0 ? 34px : 24px;
                                if r.kind == 1: Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                HorizontalLayout { spacing: 10px; padding-top: r.kind == 0 ? 10px : 0px;
                                    if r.kind == 0: Micro { text: r.a; color: Theme.blue; vertical-alignment: center; }
                                    if r.kind == 1: Text { text: r.a; font-size: 13px; color: Theme.ink; vertical-alignment: center; horizontal-stretch: 1; overflow: elide; }
                                    if r.kind == 1: Text { text: r.b; font-family: Theme.mono; font-size: 12px; font-weight: 700; color: Theme.ink; vertical-alignment: center; horizontal-alignment: right; width: 230px; overflow: elide; }
                                }
                            }
                        }
                    }
                    Micro { text: "SAVE FOR EXCEL (A .CSV FILE THAT EXCEL OPENS)"; }
                    HorizontalLayout { spacing: 8px; alignment: start;
                        Btn { text: "BILLS"; height: 30px; clicked => { root.sm-export("bills"); } }
                        Btn { text: "PAYMENTS"; height: 30px; clicked => { root.sm-export("payments"); } }
                        Btn { text: "PATIENTS"; height: 30px; clicked => { root.sm-export("patients"); } }
                        Btn { text: "DOCTORS"; height: 30px; clicked => { root.sm-export("doctors"); } }
                        Btn { text: "TESTS"; height: 30px; clicked => { root.sm-export("tests"); } }
                    }
                    HorizontalLayout { alignment: end; Btn { text: "CLOSE"; clicked => { root.sm-close(); } } }
                }
            }
        } }
    }

    // ---------- crash report ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.crveil > 0.01; opacity: root.crveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: 640px; height: min(ccard.preferred-height, root.height - 40px); y: (1 - root.crveil) * 18px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.pink; }
                ccard := VerticalLayout {
                    padding: 26px; padding-top: 30px; spacing: 10px;
                    Text { text: "LabDesk closed unexpectedly last time"; font-size: 21px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    Text { text: "Your saved work is safe. Would you like to send a crash report to the developer so it can be fixed? The report has no patient names, no results and no bills. It is only sent if you press SEND REPORT, and you read it first:"; font-size: 13px; color: Theme.ink; wrap: word-wrap; }
                    Rectangle { height: 230px; background: white; border-width: 1px; border-color: Theme.line;
                        ScrollView { Text { text: root.crash-text; font-family: Theme.mono; font-size: 11px; color: Theme.ink; wrap: word-wrap; width: 590px; } }
                    }
                    Text { text: "SEND REPORT opens your email program with the report ready to send, and saves a copy as a file."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "NOT NOW"; clicked => { root.crash-close(); } }
                        Btn { text: "SAVE AS FILE"; clicked => { root.crash-save(); } }
                        Btn { text: "SEND REPORT"; primary: true; tone: Theme.pink; clicked => { root.crash-send(); } }
                    }
                }
            }
        } }
    }

    // ---------- receive a payment later ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.pveil > 0.01; opacity: root.pveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: 470px; height: pcard.preferred-height; y: (1 - root.pveil) * 18px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.green; }
                pcard := VerticalLayout {
                    padding: 30px; padding-top: 34px; spacing: 12px;
                    Text { text: root.pay-title; font-size: 21px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    Text { text: root.pay-text; font-size: 14px; color: Theme.ink; wrap: word-wrap; }
                    Field { label: "Amount received (₹)"; text <=> root.pay-amount; mono: true; error: root.err-pay; edited(_) => { root.err-pay = ""; } }
                    Seg { label: "Paid by"; options: ["Cash", "UPI", "Card", "Bank"]; locked: [false, false, false, false]; index <=> root.pay-method; }
                    Field { label: "Note (optional)"; placeholder: "For example the UPI reference"; text <=> root.pay-ref; }
                    Rectangle { height: 6px; }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "CANCEL"; clicked => { root.pay-cancel(); } }
                        Btn { text: "RECEIVE PAYMENT"; primary: true; tone: Theme.green; clicked => { root.pay-save(); } }
                    }
                }
            }
        } }
    }

    // ---------- approve: summary, then "are you sure?" ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.apveil > 0.01; opacity: root.apveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center; padding: 30px; HorizontalLayout { alignment: center;
            Rectangle {
                width: 680px; height: min(acard.preferred-height, root.height - 60px); y: (1 - root.apveil) * 18px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.green; }
                acard := VerticalLayout {
                    padding: 28px; padding-top: 32px; spacing: 10px;
                    Text { text: "Please check everything before approving"; font-size: 21px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    Rectangle { height: 62px; background: Theme.bg;
                        VerticalLayout { padding: 10px; padding-left: 14px; spacing: 2px; alignment: center;
                            Text { text: root.ap-name; font-size: 17px; font-weight: 700; color: Theme.ink; overflow: elide; }
                            Text { text: root.ap-meta; font-size: 12px; color: Theme.muted; overflow: elide; }
                        }
                    }
                    Text { text: root.ap-counts; font-size: 13px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                    Rectangle { vertical-stretch: 1; min-height: 230px; border-width: 1px; border-color: Theme.line; clip: true;
                        ScrollView {
                            VerticalLayout {
                                for r in root.ap-rows: Rectangle {
                                    height: r.kind == 0 ? 32px : 26px;
                                    background: r.kind == 0 ? Theme.bg : transparent;
                                    Rectangle { y: parent.height - 1px; height: 1px; background: Theme.line; }
                                    if r.kind == 0: Text { x: 10px; text: r.name; font-size: 13px; font-weight: 700; color: Theme.ink; vertical-alignment: center; }
                                    if r.kind == 1: HorizontalLayout { padding-left: 16px; padding-right: 10px; spacing: 10px;
                                        Text { text: r.name; horizontal-stretch: 1; font-size: 12px; color: Theme.ink; vertical-alignment: center; overflow: elide; }
                                        Text { text: r.value; width: 130px; font-family: Theme.mono; font-size: 12px; font-weight: 700; color: r.flag == "Critical" ? Theme.red : r.flag != "" ? Theme.amber : Theme.ink; horizontal-alignment: right; vertical-alignment: center; }
                                        Text { text: r.range; width: 110px; font-size: 11px; color: Theme.muted; vertical-alignment: center; overflow: elide; }
                                        Text { text: r.flag; width: 56px; font-size: 11px; font-weight: 700; color: r.flag == "Critical" ? Theme.red : Theme.amber; vertical-alignment: center; }
                                    }
                                }
                            }
                        }
                    }
                    if root.ap-warn != "": Text { text: root.ap-warn; font-size: 12px; font-weight: 700; color: Theme.red; wrap: word-wrap; }
                    Text { text: root.ap-by; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    Text { text: "Are you sure you want to continue?"; font-size: 15px; font-weight: 700; color: Theme.ink; }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "NO, GO BACK"; clicked => { root.ap-cancel(); } }
                        Btn { text: "YES, APPROVE"; primary: true; tone: Theme.green; clicked => { root.ap-confirm(); } }
                    }
                }
            }
        } }
    }

    // ---------- "Are you sure?" box ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.cveil > 0.01;
        opacity: root.cveil;
        background: #14130f70;
        TouchArea { }
        VerticalLayout {
            alignment: center;
            HorizontalLayout {
                alignment: center;
                Rectangle {
                    width: 470px; height: dcard.preferred-height;
                    y: (1 - root.cveil) * 18px;
                    background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                    drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                    Rectangle { y: 0px; height: 5px; background: Theme.ink; }
                    dcard := VerticalLayout {
                        padding: 30px; padding-top: 34px; spacing: 12px;
                        Text { text: root.confirm-title; font-size: 21px; font-weight: 700; color: Theme.ink; wrap: word-wrap; }
                        Text { text: root.confirm-text; font-size: 14px; color: Theme.ink; wrap: word-wrap; }
                        if root.confirm-extra-label != "": Field { label: root.confirm-extra-label; password: root.confirm-extra-secret; text <=> root.confirm-extra; error: root.err-confirm-extra; edited(_) => { root.err-confirm-extra = ""; } }
                        if root.confirm-needs-password: Field { label: "Your password"; placeholder: "Type your own password"; password: true; text <=> root.confirm-pass; error: root.err-confirm; edited(_) => { root.err-confirm = ""; } accepted => { root.confirm-yes-clicked(); } }
                        Rectangle { height: 6px; }
                        HorizontalLayout { spacing: 10px; alignment: end;
                            Btn { text: root.confirm-no-text; clicked => { root.confirm-no-clicked(); } }
                            Btn { text: root.confirm-yes; primary: true; clicked => { root.confirm-yes-clicked(); } }
                        }
                    }
                }
            }
        }
    }

    // ---------- comment / interpretation / guidelines ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.civeil > 0.01; opacity: root.civeil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center;
            HorizontalLayout { alignment: center;
                Rectangle {
                    width: 640px; height: 470px; y: (1 - root.civeil) * 18px;
                    background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                    drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                    Rectangle { y: 0px; height: 5px; background: Theme.ink; }
                    VerticalLayout { padding: 26px; padding-top: 30px; spacing: 12px;
                        Text { text: root.ci-title; font-size: 20px; font-weight: 700; color: Theme.ink; }
                        TextEdit { text <=> root.ci-text; vertical-stretch: 1; font-size: 13px; wrap: word-wrap; }
                        HorizontalLayout { spacing: 10px; alignment: end;
                            Btn { text: "CANCEL"; clicked => { root.ci-cancel(); } }
                            Btn { text: "KEEP THIS TEXT"; primary: true; clicked => { root.ci-save(); } }
                        }
                    }
                }
            }
        }
    }

    // ---------- age and gender ranges ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.arveil > 0.01; opacity: root.arveil; background: #14130f70;
        TouchArea { }
        VerticalLayout { alignment: center;
            HorizontalLayout { alignment: center;
                Rectangle {
                    width: 900px; height: 520px; y: (1 - root.arveil) * 18px;
                    background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                    drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                    Rectangle { y: 0px; height: 5px; background: Theme.ink; }
                    VerticalLayout { padding: 26px; padding-top: 30px; spacing: 10px;
                        Text { text: "Normal ranges by age and gender"; font-size: 20px; font-weight: 700; color: Theme.ink; }
                        Text { text: "The first row that fits the patient's age and gender is used. Empty boxes keep the field's main range. For a baby, use Days or Months."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                        Rectangle { height: 26px; background: Theme.bg;
                            HorizontalLayout { padding-left: 6px; padding-right: 6px; spacing: 6px;
                                Micro { text: "GENDER"; width: 84px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "FROM"; width: 62px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "TO"; width: 62px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "AGE IN"; width: 84px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "LOW"; width: 60px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "HIGH"; width: 60px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "CRIT <"; width: 60px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "CRIT >"; width: 60px; font-size: 10px; vertical-alignment: center; }
                                Micro { text: "PRINT AS (OPTIONAL)"; horizontal-stretch: 1; font-size: 10px; vertical-alignment: center; }
                                Rectangle { width: 30px; }
                            }
                        }
                        ScrollView { vertical-stretch: 1;
                            VerticalLayout { spacing: 6px;
                                for a[i] in root.ar-rows: HorizontalLayout { spacing: 6px; padding-left: 6px; padding-right: 6px;
                                    Pick { width: 84px; text: a.gender; options: ["Both", "Male", "Female"]; menu-width: 110px; picked(t) => { root.ar-edit(i, 7, t); } }
                                    Cell { width: 62px; text: a.from; edited(t) => { root.ar-edit(i, 0, t); } }
                                    Cell { width: 62px; text: a.to; edited(t) => { root.ar-edit(i, 1, t); } }
                                    Pick { width: 84px; text: a.unit; options: ["Years", "Months", "Days"]; menu-width: 110px; picked(t) => { root.ar-edit(i, 8, t); } }
                                    Cell { width: 60px; text: a.low; edited(t) => { root.ar-edit(i, 2, t); } }
                                    Cell { width: 60px; text: a.high; edited(t) => { root.ar-edit(i, 3, t); } }
                                    Cell { width: 60px; text: a.clow; edited(t) => { root.ar-edit(i, 4, t); } }
                                    Cell { width: 60px; text: a.chigh; edited(t) => { root.ar-edit(i, 5, t); } }
                                    Cell { horizontal-stretch: 1; mono: false; text: a.text; placeholder: "e.g. up to 14"; edited(t) => { root.ar-edit(i, 6, t); } }
                                    Rectangle { width: 30px; height: 32px; border-width: 1px; border-color: #d99; background: white;
                                        Cross { tone: Theme.red; x: 9px; y: 10px; width: 12px; height: 12px; }
                                        TouchArea { clicked => { root.ar-remove(i); } mouse-cursor: pointer; } }
                                }
                            }
                        }
                        HorizontalLayout { spacing: 10px;
                            Btn { text: "+  ADD A ROW"; clicked => { root.ar-add(); } }
                            Rectangle { horizontal-stretch: 1; }
                            Btn { text: "CANCEL"; clicked => { root.ar-cancel(); } }
                            Btn { text: "DONE"; primary: true; clicked => { root.ar-done(); } }
                        }
                    }
                }
            }
        }
    }

    // ---------- recovery code shown once ----------
    Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height;
        visible: root.rveil > 0.01; opacity: root.rveil; background: #14130fa0;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: 540px; height: rcard.preferred-height; y: (1 - root.rveil) * 20px;
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                drop-shadow-blur: 34px; drop-shadow-color: #14130f50; drop-shadow-offset-y: 12px;
                Rectangle { y: 0px; height: 5px; background: Theme.pink; }
                rcard := VerticalLayout {
                    padding: 30px; padding-top: 34px; spacing: 12px;
                    Text { text: "Your recovery code"; font-size: 22px; font-weight: 700; color: Theme.ink; }
                    Text { text: "Write this down now. It is shown only once. If you ever forget your Admin password, this code lets you choose a new one on the sign-in screen."; font-size: 14px; color: Theme.ink; wrap: word-wrap; }
                    Rectangle {
                        height: 64px; background: white; border-width: 2px; border-color: Theme.ink;
                        Text { text: root.rc-code; font-family: Theme.mono; font-size: 24px; font-weight: 800; letter-spacing: 2px; color: Theme.ink; horizontal-alignment: center; vertical-alignment: center; }
                    }
                    Text { text: "Keep it away from this computer: on paper in a safe place, or on a USB drive. Anyone who has this code can take over an Admin account."; font-size: 12px; color: Theme.muted; wrap: word-wrap; }
                    Rectangle { height: 4px; }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "SAVE A COPY…"; clicked => { root.rc-save-copy(); } }
                        Btn { text: "I HAVE SAVED IT"; primary: true; clicked => { root.rc-done(); } }
                    }
                }
            }
        } }
    }

    // ---- Terms of Use and Privacy: shown first, until accepted ----
    if root.terms-needed: Rectangle {
        x: 0px; y: 0px; width: root.width; height: root.height; background: Theme.paper;
        TouchArea { }
        VerticalLayout { alignment: center; HorizontalLayout { alignment: center;
            Rectangle {
                width: min(760px, root.width - 48px); height: min(root.height - 48px, 720px);
                background: Theme.paper; border-width: 1px; border-color: Theme.ink;
                Rectangle { y: 0px; height: 5px; background: Theme.ink; }
                VerticalLayout {
                    padding: 28px; padding-top: 32px; spacing: 12px;
                    Text { text: "Before you start"; font-size: 22px; font-weight: 700; color: Theme.ink; }
                    Text { text: "Please read the Terms of Use and Privacy below. You must agree to them to use LabDesk."; font-size: 13px; color: Theme.muted; wrap: word-wrap; }
                    Rectangle {
                        vertical-stretch: 1; background: white; border-width: 1px; border-color: Theme.line;
                        ScrollView {
                            VerticalLayout { padding: 16px; Text { text: root.terms-text; font-size: 13px; color: Theme.ink; wrap: word-wrap; } }
                        }
                    }
                    HorizontalLayout { spacing: 10px; height: 30px;
                        Rectangle {
                            width: 24px; height: 24px; y: 3px; background: root.terms-ok ? Theme.ink : white; border-width: 2px; border-color: Theme.ink;
                            if root.terms-ok: Tick { tone: white; x: 4px; y: 4px; width: 14px; height: 14px; }
                            TouchArea { clicked => { root.terms-ok = !root.terms-ok; } mouse-cursor: pointer; }
                        }
                        Text { text: "I have read and agree to the Terms of Use and Privacy"; font-size: 14px; font-weight: 600; color: Theme.ink; vertical-alignment: center; }
                    }
                    HorizontalLayout { spacing: 10px; alignment: end;
                        Btn { text: "I DON'T AGREE, CLOSE"; clicked => { root.terms-decline(); } }
                        Btn { text: "AGREE AND CONTINUE"; primary: true; enabled: root.terms-ok; clicked => { root.terms-accept(); } }
                    }
                }
            }
        } }
    }

    Toast { x: 0px; y: 0px; width: root.width; height: root.height; text: root.toast-text; bad: root.toast-bad; shown: root.toast-shown; dismissed => { root.dismiss-toast(); } }
}
